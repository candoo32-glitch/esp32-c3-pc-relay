{
  "version": 2,
  "name": "Nebula V2",
  "responsive": true,
  "defaultView": "dashboard",
  "tokens": {
    "accent": "#67d9ff",
    "panel": "rgba(14,22,40,.96)",
    "surface": "rgba(22,34,58,.94)",
    "border": "#34547e",
    "radius": "12px",
    "panelPadding": "16px"
  },
  "views": {
    "dashboard": {
      "title": "NEBULA // COMMAND",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(4,minmax(0,1fr))",
        "gap": "12px",
        "children": [
          {
            "type": "relay-dock"
          },
          {
            "type": "panel",
            "label": "SYSTEM",
            "children": [
              {
                "type": "value",
                "label": "Firmware",
                "bind": "system.build"
              },
              {
                "type": "value",
                "label": "Web UI",
                "bind": "system.webBuild"
              },
              {
                "type": "value",
                "label": "CPU",
                "bind": "system.cpu",
                "format": "number"
              },
              {
                "type": "value",
                "label": "Uptime",
                "bind": "system.uptime",
                "format": "number"
              },
              {
                "type": "value",
                "label": "ESP-IDF",
                "bind": "system.idf"
              }
            ]
          },
          {
            "type": "panel",
            "label": "WI-FI",
            "children": [
              {
                "type": "value",
                "label": "Status",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "SSID",
                "bind": "wifi.ssid"
              },
              {
                "type": "value",
                "label": "IP",
                "bind": "wifi.ip"
              },
              {
                "type": "value",
                "label": "RSSI",
                "bind": "wifi.rssi",
                "format": "dbm"
              },
              {
                "type": "value",
                "label": "Channel",
                "bind": "wifi.channel"
              },
              {
                "type": "value",
                "label": "BSSID",
                "bind": "wifi.bssid"
              },
              {
                "type": "value",
                "label": "TX power",
                "bind": "wifi.tx"
              }
            ]
          },
          {
            "type": "gauge",
            "label": "CPU MHz",
            "bind": "system.cpu",
            "min": 0,
            "max": 240,
            "format": "number"
          },
          {
            "type": "meter",
            "label": "SIGNAL STRENGTH",
            "bind": "wifi.rssi",
            "min": -100,
            "max": 0
          },
          {
            "type": "panel",
            "label": "RELAY 1",
            "children": [
              {
                "type": "relay",
                "relay": 0
              }
            ]
          },
          {
            "type": "panel",
            "label": "RELAY 2",
            "children": [
              {
                "type": "relay",
                "relay": 1
              }
            ]
          },
          {
            "type": "panel",
            "label": "NETWORK",
            "children": [
              {
                "type": "value",
                "label": "IP",
                "bind": "network.ip"
              },
              {
                "type": "value",
                "label": "Gateway",
                "bind": "network.gateway"
              },
              {
                "type": "value",
                "label": "Subnet",
                "bind": "network.subnet"
              },
              {
                "type": "value",
                "label": "DNS 1",
                "bind": "network.dns1"
              },
              {
                "type": "value",
                "label": "DNS 2",
                "bind": "network.dns2"
              },
              {
                "type": "value",
                "label": "Authentication",
                "bind": "network.auth"
              }
            ]
          },
          {
            "type": "panel",
            "label": "QUICK CONTROLS",
            "children": [
              {
                "type": "button",
                "text": "Reconnect Wi-Fi",
                "action": {
                  "action": "wifi.reconnect"
                }
              },
              {
                "type": "button",
                "text": "Wi-Fi On / Off",
                "action": {
                  "action": "wifi.toggle"
                }
              },
              {
                "type": "button",
                "text": "Reboot ESP32-C3",
                "action": {
                  "action": "system.reboot"
                }
              }
            ]
          },
          {
            "type": "panel",
            "label": "RELAY TELEMETRY",
            "children": [
              {
                "type": "relay-detail",
                "relay": 0,
                "gpio": 5
              },
              {
                "type": "relay-detail",
                "relay": 1,
                "gpio": 6
              }
            ]
          }
        ]
      }
    },
    "wifi": {
      "title": "WI-FI",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(2,minmax(0,1fr))",
        "gap": "12px",
        "children": [
          {
            "type": "relay-dock"
          },
          {
            "type": "panel",
            "label": "CONNECTION",
            "children": [
              {
                "type": "value",
                "label": "Status",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "SSID",
                "bind": "wifi.ssid"
              },
              {
                "type": "value",
                "label": "IP address",
                "bind": "wifi.ip"
              },
              {
                "type": "value",
                "label": "Gateway",
                "bind": "wifi.gateway"
              },
              {
                "type": "value",
                "label": "Subnet",
                "bind": "wifi.subnet"
              },
              {
                "type": "value",
                "label": "DNS",
                "bind": "wifi.dns"
              },
              {
                "type": "value",
                "label": "BSSID",
                "bind": "wifi.bssid"
              },
              {
                "type": "value",
                "label": "RSSI",
                "bind": "wifi.rssi",
                "format": "dbm"
              },
              {
                "type": "value",
                "label": "TX power",
                "bind": "wifi.tx"
              },
              {
                "type": "button",
                "text": "Wi-Fi On / Off",
                "action": {
                  "action": "wifi.toggle"
                }
              },
              {
                "type": "button",
                "text": "Reconnect now",
                "action": {
                  "action": "wifi.reconnect"
                }
              }
            ]
          },
          {
            "type": "panel",
            "label": "CREDENTIALS",
            "children": [
              {
                "type": "form",
                "action": "/wifi/save",
                "children": [
                  {
                    "type": "field",
                    "label": "NETWORK / SSID",
                    "children": [
                      {
                        "type": "wifi-scanner",
                        "name": "ssid"
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "PASSWORD",
                    "children": [
                      {
                        "type": "secret",
                        "name": "password",
                        "placeholder": "Leave blank for open network",
                        "maxLength": 63
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "text": "Test and save credentials",
                    "submit": true
                  }
                ]
              },
              {
                "type": "text",
                "text": "The saved password is never exposed to DOM V2."
              }
            ]
          },
          {
            "type": "panel",
            "label": "DISCOVERY",
            "children": [
              {
                "type": "wifi-scanner",
                "name": "ssid"
              },
              {
                "type": "text",
                "text": "Select an access point to place its SSID in the field above. Hidden networks can still be entered manually."
              }
            ]
          },
          {
            "type": "panel",
            "label": "RADIO POWER",
            "children": [
              {
                "type": "form",
                "action": "/wifi/txpower",
                "children": [
                  {
                    "type": "input",
                    "name": "dbm",
                    "bind": "wifi.tx",
                    "inputType": "number",
                    "min": 2,
                    "max": 18,
                    "step": 0.25
                  },
                  {
                    "type": "button",
                    "text": "Save TX power",
                    "submit": true
                  }
                ]
              },
              {
                "type": "text",
                "text": "Allowed range: 2.00–18.00 dBm in 0.25 dBm steps."
              }
            ]
          }
        ]
      }
    },
    "network": {
      "title": "NETWORK",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(2,minmax(0,1fr))",
        "gap": "12px",
        "children": [
          {
            "type": "relay-dock"
          },
          {
            "type": "panel",
            "label": "LIVE CONNECTION",
            "children": [
              {
                "type": "value",
                "label": "Wi-Fi",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "IP address",
                "bind": "network.ip"
              },
              {
                "type": "value",
                "label": "Gateway",
                "bind": "network.gateway"
              },
              {
                "type": "value",
                "label": "Subnet",
                "bind": "network.subnet"
              },
              {
                "type": "value",
                "label": "DNS 1",
                "bind": "network.dns1"
              },
              {
                "type": "value",
                "label": "DNS 2",
                "bind": "network.dns2"
              },
              {
                "type": "value",
                "label": "RSSI",
                "bind": "wifi.rssi",
                "format": "dbm"
              },
              {
                "type": "value",
                "label": "Authentication",
                "bind": "network.auth"
              },
              {
                "type": "value",
                "label": "BSSID",
                "bind": "network.bssid"
              }
            ]
          },
          {
            "type": "panel",
            "label": "CONFIGURATION",
            "children": [
              {
                "type": "form",
                "action": "/network/save",
                "children": [
                  {
                    "type": "field",
                    "label": "HOSTNAME",
                    "children": [
                      {
                        "type": "input",
                        "name": "hostname",
                        "bind": "network.hostname",
                        "maxLength": 32,
                        "placeholder": "device-name"
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "ADDRESS MODE",
                    "children": [
                      {
                        "type": "select",
                        "name": "mode",
                        "bind": "network.mode",
                        "options": [
                          {
                            "value": "dhcp",
                            "label": "DHCP"
                          },
                          {
                            "value": "static",
                            "label": "STATIC"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "STATIC IP ADDRESS",
                    "children": [
                      {
                        "type": "input",
                        "name": "ip",
                        "bind": "network.ip",
                        "placeholder": "192.168.1.50"
                      }
                    ],
                    "visibleIf": "network.mode == static"
                  },
                  {
                    "type": "field",
                    "label": "STATIC GATEWAY",
                    "children": [
                      {
                        "type": "input",
                        "name": "gateway",
                        "bind": "network.gateway"
                      }
                    ],
                    "visibleIf": "network.mode == static"
                  },
                  {
                    "type": "field",
                    "label": "STATIC SUBNET",
                    "children": [
                      {
                        "type": "input",
                        "name": "subnet",
                        "bind": "network.subnet"
                      }
                    ],
                    "visibleIf": "network.mode == static"
                  },
                  {
                    "type": "field",
                    "label": "STATIC DNS 1",
                    "children": [
                      {
                        "type": "input",
                        "name": "dns1",
                        "bind": "network.dns1"
                      }
                    ],
                    "visibleIf": "network.mode == static"
                  },
                  {
                    "type": "field",
                    "label": "STATIC DNS 2",
                    "children": [
                      {
                        "type": "input",
                        "name": "dns2",
                        "bind": "network.dns2"
                      }
                    ],
                    "visibleIf": "network.mode == static"
                  },
                  {
                    "type": "button",
                    "text": "Save network settings",
                    "submit": true
                  }
                ]
              },
              {
                "type": "text",
                "text": "DHCP is recommended unless the device needs a fixed address."
              }
            ]
          }
        ]
      }
    },
    "diagnostics": {
      "title": "DIAGNOSTICS",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "1fr",
        "gap": "12px",
        "children": [
          {
            "type": "panel",
            "label": "DOM V2 TELEMETRY",
            "children": [
              {
                "type": "value",
                "label": "Runtime",
                "value": "DOM V2"
              },
              {
                "type": "value",
                "label": "Presentation",
                "value": "Nebula V2"
              },
              {
                "type": "text",
                "text": "Nebula is an external presentation rendered by DOM V2; the protected built-in UI and V1 themes remain separate."
              }
            ]
          },
          {
            "type": "relay-dock"
          },
          {
            "type": "panel",
            "label": "DIAGNOSTIC STATE",
            "children": [
              {
                "type": "status",
                "label": "Diagnostics",
                "bind": "diagnostics.enabled",
                "map": {
                  "0": "DISABLED",
                  "1": "ENABLED",
                  "true": "ENABLED",
                  "false": "DISABLED"
                }
              },
              {
                "type": "button",
                "text": "Toggle diagnostics",
                "action": {
                  "action": "diagnostics.toggle"
                }
              }
            ]
          },
          {
            "type": "panel",
            "label": "LIVE SERIAL CONSOLE",
            "children": [
              {
                "type": "log",
                "bind": "diagnosticsLog"
              }
            ]
          },
          {
            "type": "panel",
            "label": "CONNECTION SNAPSHOT",
            "children": [
              {
                "type": "value",
                "label": "Wi-Fi state",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "Authentication",
                "bind": "network.auth"
              },
              {
                "type": "value",
                "label": "BSSID",
                "bind": "network.bssid"
              },
              {
                "type": "value",
                "label": "RSSI",
                "bind": "wifi.rssi",
                "format": "dbm"
              }
            ]
          }
        ]
      }
    },
    "relays": {
      "title": "RELAYS",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(2,minmax(0,1fr))",
        "gap": "12px",
        "children": [
          {
            "type": "relay-dock"
          },
          {
            "type": "panel",
            "label": "RELAY 1 TELEMETRY",
            "children": [
              {
                "type": "relay-detail",
                "relay": 0,
                "gpio": 5
              }
            ]
          },
          {
            "type": "panel",
            "label": "RELAY 2 TELEMETRY",
            "children": [
              {
                "type": "relay-detail",
                "relay": 1,
                "gpio": 6
              }
            ]
          },
          {
            "type": "relay",
            "relay": 0
          },
          {
            "type": "relay",
            "relay": 1
          },
          {
            "type": "panel",
            "label": "RELAY CONFIGURATION",
            "children": [
              {
                "type": "form",
                "action": "/relay/config",
                "children": [
                  {
                    "type": "field",
                    "label": "RELAY 1 NAME",
                    "children": [
                      {
                        "type": "input",
                        "name": "relay0_name",
                        "bind": "relays[0].name",
                        "maxLength": 32,
                        "placeholder": "Relay 1"
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "RELAY 1 NORMAL STATE",
                    "children": [
                      {
                        "type": "select",
                        "name": "relay0_normal",
                        "bind": "relays[0].normal",
                        "options": [
                          {
                            "value": "open",
                            "label": "OPEN"
                          },
                          {
                            "value": "closed",
                            "label": "CLOSED"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "RELAY 1 ACTIVATION MODE",
                    "children": [
                      {
                        "type": "select",
                        "name": "relay0_mode",
                        "bind": "relays[0].mode",
                        "options": [
                          {
                            "value": "latched",
                            "label": "LATCHED"
                          },
                          {
                            "value": "pulse",
                            "label": "PULSE"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "RELAY 1 PULSE",
                    "children": [
                      {
                        "type": "input",
                        "name": "relay0_pulse",
                        "bind": "relays[0].pulse",
                        "inputType": "number",
                        "min": 10,
                        "max": 60000,
                        "step": 1
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "RELAY 2 NAME",
                    "children": [
                      {
                        "type": "input",
                        "name": "relay1_name",
                        "bind": "relays[1].name",
                        "maxLength": 32,
                        "placeholder": "Relay 2"
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "RELAY 2 NORMAL STATE",
                    "children": [
                      {
                        "type": "select",
                        "name": "relay1_normal",
                        "bind": "relays[1].normal",
                        "options": [
                          {
                            "value": "open",
                            "label": "OPEN"
                          },
                          {
                            "value": "closed",
                            "label": "CLOSED"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "RELAY 2 ACTIVATION MODE",
                    "children": [
                      {
                        "type": "select",
                        "name": "relay1_mode",
                        "bind": "relays[1].mode",
                        "options": [
                          {
                            "value": "latched",
                            "label": "LATCHED"
                          },
                          {
                            "value": "pulse",
                            "label": "PULSE"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "RELAY 2 PULSE",
                    "children": [
                      {
                        "type": "input",
                        "name": "relay1_pulse",
                        "bind": "relays[1].pulse",
                        "inputType": "number",
                        "min": 10,
                        "max": 60000,
                        "step": 1
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "text": "Save both relay configurations",
                    "submit": true
                  }
                ]
              },
              {
                "type": "text",
                "text": "Pulse duration: 10–60000 ms. Blank/default is 250 ms."
              }
            ]
          }
        ]
      }
    },
    "storage": {
      "title": "STORAGE",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(2,minmax(0,1fr))",
        "gap": "12px",
        "children": [
          {
            "type": "relay-dock"
          },
          {
            "type": "panel",
            "label": "NVS STATUS",
            "children": [
              {
                "type": "value",
                "label": "Partition size",
                "bind": "nvs.size",
                "format": "number"
              },
              {
                "type": "value",
                "label": "Used entries",
                "bind": "nvs.used",
                "format": "number"
              },
              {
                "type": "value",
                "label": "Free entries",
                "bind": "nvs.free",
                "format": "number"
              },
              {
                "type": "link",
                "text": "Download configuration backup",
                "href": "/config/backup"
              },
              {
                "type": "nvs-browser"
              }
            ]
          },
          {
            "type": "panel",
            "label": "FILESYSTEM",
            "children": [
              {
                "type": "form",
                "action": "/storage/upload",
                "children": [
                  {
                    "type": "input",
                    "name": "storagefile",
                    "inputType": "file",
                    "required": true
                  },
                  {
                    "type": "button",
                    "text": "Upload / replace file",
                    "submit": true
                  }
                ]
              },
              {
                "type": "link",
                "text": "Open Recovery Updater",
                "href": "/recovery",
                "target": "_blank"
              },
              {
                "type": "file-browser"
              }
            ]
          },
          {
            "type": "panel",
            "label": "CONFIGURATION BACKUP",
            "children": [
              {
                "type": "link",
                "text": "Download backup",
                "href": "/config/backup"
              },
              {
                "type": "form",
                "action": "/config/restore",
                "children": [
                  {
                    "type": "input",
                    "name": "configfile",
                    "inputType": "file",
                    "required": true
                  },
                  {
                    "type": "button",
                    "text": "Restore & reboot",
                    "submit": true
                  }
                ]
              },
              {
                "type": "text",
                "text": "Backups contain saved configuration and Wi-Fi credentials; treat them as sensitive."
              }
            ]
          },
          {
            "type": "panel",
            "label": "DANGER ZONE",
            "children": [
              {
                "type": "text",
                "text": "Erase persistent NVS configuration, including Wi-Fi and network settings, then reboot."
              },
              {
                "type": "form",
                "action": "/nvs/format",
                "children": [
                  {
                    "type": "button",
                    "text": "Format NVS and reboot",
                    "submit": true
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "label": "STORAGE OPERATIONS",
            "children": [
              {
                "type": "text",
                "text": "V2 exposes the same SPIFFS and NVS inspection capabilities as the protected built-in interface. Sensitive NVS values remain masked by firmware."
              },
              {
                "type": "link",
                "text": "Open Recovery Updater",
                "href": "/recovery",
                "target": "_blank"
              }
            ]
          }
        ]
      }
    },
    "system": {
      "title": "SYSTEM",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(2,minmax(0,1fr))",
        "gap": "12px",
        "children": [
          {
            "type": "relay-dock"
          },
          {
            "type": "panel",
            "label": "FIRMWARE",
            "children": [
              {
                "type": "value",
                "label": "Repository",
                "bind": "system.repository"
              },
              {
                "type": "value",
                "label": "Firmware build",
                "bind": "system.build"
              },
              {
                "type": "value",
                "label": "Web UI",
                "bind": "system.webBuild"
              },
              {
                "type": "value",
                "label": "Build date",
                "bind": "system.date"
              },
              {
                "type": "value",
                "label": "ESP-IDF",
                "bind": "system.idf"
              },
              {
                "type": "value",
                "label": "Arduino",
                "bind": "system.arduino"
              },
              {
                "type": "value",
                "label": "Chip",
