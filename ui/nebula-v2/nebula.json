{
  "version": 2,
  "name": "Nebula V2",
  "responsive": true,
  "defaultView": "dashboard",
  "tokens": {
    "accent": "#67d9ff",
    "panel": "rgba(14,22,40,.96)",
    "surface": "rgba(22,34,58,.94)",
    "border": "#34547e",
    "radius": "12px",
    "panelPadding": "18px"
  },
  "views": {
    "dashboard": {
      "title": "COMMAND CENTER",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(12,minmax(0,1fr))",
        "gap": "16px",
        "children": [
          {
            "type": "relay-dock"
          },
          {
            "type": "panel",
            "label": "SYSTEM STATUS",
            "children": [
              {
                "type": "value",
                "label": "Firmware build",
                "bind": "system.build"
              },
              {
                "type": "value",
                "label": "Web UI build",
                "bind": "system.webBuild"
              },
              {
                "type": "value",
                "label": "ESP-IDF",
                "bind": "system.idf"
              },
              {
                "type": "value",
                "label": "Arduino core",
                "bind": "system.arduino"
              },
              {
                "type": "value",
                "label": "CPU",
                "bind": "system.cpu",
                "format": "number"
              },
              {
                "type": "value",
                "label": "Uptime",
                "bind": "system.uptime",
                "format": "number"
              }
            ]
          },
          {
            "type": "panel",
            "label": "WIRELESS STATUS",
            "children": [
              {
                "type": "status",
                "label": "Connection",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "SSID",
                "bind": "wifi.ssid"
              },
              {
                "type": "value",
                "label": "IP address",
                "bind": "wifi.ip"
              },
              {
                "type": "value",
                "label": "RSSI",
                "bind": "wifi.rssi",
                "format": "dbm"
              },
              {
                "type": "value",
                "label": "Channel",
                "bind": "wifi.channel"
              },
              {
                "type": "value",
                "label": "BSSID",
                "bind": "wifi.bssid"
              }
            ]
          },
          {
            "type": "panel",
            "label": "NETWORK",
            "children": [
              {
                "type": "value",
                "label": "Gateway",
                "bind": "network.gateway"
              },
              {
                "type": "value",
                "label": "Subnet",
                "bind": "network.subnet"
              },
              {
                "type": "value",
                "label": "DNS 1",
                "bind": "network.dns1"
              },
              {
                "type": "value",
                "label": "DNS 2",
                "bind": "network.dns2"
              },
              {
                "type": "value",
                "label": "Authentication",
                "bind": "network.auth"
              }
            ]
          },
          {
            "type": "panel",
            "label": "SIGNAL",
            "children": [
              {
                "type": "meter",
                "label": "Wi-Fi RSSI",
                "bind": "wifi.rssi",
                "min": -100,
                "max": 0
              },
              {
                "type": "text",
                "text": "Signal is shown live from the active Wi-Fi connection."
              }
            ]
          },
          {
            "type": "panel",
            "label": "RELAY 1",
            "children": [
              {
                "type": "relay",
                "relay": 0
              }
            ]
          },
          {
            "type": "panel",
            "label": "RELAY 2",
            "children": [
              {
                "type": "relay",
                "relay": 1
              }
            ]
          },
          {
            "type": "panel",
            "label": "RELAY TELEMETRY",
            "children": [
              {
                "type": "relay-detail",
                "relay": 0,
                "gpio": 5
              },
              {
                "type": "relay-detail",
                "relay": 1,
                "gpio": 6
              }
            ]
          },
          {
            "type": "panel",
            "label": "QUICK ACTIONS",
            "children": [
              {
                "type": "button",
                "text": "Reconnect Wi-Fi",
                "action": {
                  "action": "wifi.reconnect"
                }
              },
              {
                "type": "button",
                "text": "Turn Wi-Fi ON / OFF",
                "action": {
                  "action": "wifi.toggle"
                }
              },
              {
                "type": "button",
                "text": "Reboot ESP32-C3",
                "action": {
                  "action": "system.reboot"
                }
              }
            ]
          }
        ]
      }
    },
    "wifi": {
      "title": "WI-FI",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(12,minmax(0,1fr))",
        "gap": "16px",
        "children": [
          {
            "type": "relay-dock"
          },
          {
            "type": "panel",
            "label": "CURRENT CONNECTION",
            "children": [
              {
                "type": "status",
                "label": "Status",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "Connected network",
                "bind": "wifi.ssid"
              },
              {
                "type": "value",
                "label": "IP address",
                "bind": "wifi.ip"
              },
              {
                "type": "value",
                "label": "Gateway",
                "bind": "wifi.gateway"
              },
              {
                "type": "value",
                "label": "Subnet",
                "bind": "wifi.subnet"
              },
              {
                "type": "value",
                "label": "DNS",
                "bind": "wifi.dns"
              },
              {
                "type": "value",
                "label": "BSSID",
                "bind": "wifi.bssid"
              },
              {
                "type": "value",
                "label": "RSSI",
                "bind": "wifi.rssi",
                "format": "dbm"
              },
              {
                "type": "value",
                "label": "Channel",
                "bind": "wifi.channel"
              },
              {
                "type": "value",
                "label": "TX power",
                "bind": "wifi.tx"
              }
            ]
          },
          {
            "type": "panel",
            "label": "CONNECTION CONTROLS",
            "children": [
              {
                "type": "button",
                "text": "Turn Wi-Fi ON / OFF",
                "action": {
                  "action": "wifi.toggle"
                }
              },
              {
                "type": "button",
                "text": "Reconnect now",
                "action": {
                  "action": "wifi.reconnect"
                }
              },
              {
                "type": "text",
                "text": "These controls affect the current radio state. Saved credentials are handled separately below."
              }
            ]
          },
          {
            "type": "panel",
            "label": "WI-FI CREDENTIALS",
            "children": [
              {
                "type": "form",
                "action": "/wifi/save",
                "children": [
                  {
                    "type": "field",
                    "label": "Network / SSID",
                    "children": [
                      {
                        "type": "input",
                        "id": "ssid",
                        "name": "ssid",
                        "bind": "wifi.savedSsid",
                        "maxLength": 32,
                        "required": true,
                        "autocomplete": "off"
                      },
                      {
                        "type": "text",
                        "text": "Enter the SSID manually, or select one from the nearby-network scan."
                      }
                    ]
                  },
                  {
                    "type": "wifi-scanner",
                    "target": "#v2-ssid"
                  },
                  {
                    "type": "field",
                    "label": "Password",
                    "children": [
                      {
                        "type": "secret",
                        "name": "password",
                        "savedBind": "wifi.passwordSaved",
                        "placeholder": "********",
                        "maxLength": 63
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": "Credentials are saved only after a successful connection. Leave the password empty only for an open network."
                  },
                  {
                    "type": "button",
                    "text": "Test and save credentials",
                    "submit": true
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "label": "RADIO POWER",
            "children": [
              {
                "type": "form",
                "action": "/wifi/txpower",
                "children": [
                  {
                    "type": "field",
                    "label": "Transmit power (dBm)",
                    "children": [
                      {
                        "type": "input",
                        "name": "dbm",
                        "bind": "wifi.tx",
                        "inputType": "number",
                        "min": 2,
                        "max": 18,
                        "step": 0.25
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": "Allowed range: 2.00–18.00 dBm in 0.25 dBm increments."
                  },
                  {
                    "type": "button",
                    "text": "Save TX power",
                    "submit": true
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "label": "NEARBY NETWORKS",
            "children": [
              {
                "type": "wifi-scanner",
                "target": "#v2-ssid"
              },
              {
                "type": "text",
                "text": "Select a row to place its SSID into the credentials form. Hidden networks can still be entered manually."
              }
            ]
          }
        ]
      }
    },
    "network": {
      "title": "NETWORK",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(12,minmax(0,1fr))",
        "gap": "16px",
        "children": [
          {
            "type": "relay-dock"
          },
          {
            "type": "panel",
            "label": "NETWORK CONFIGURATION",
            "children": [
              {
                "type": "text",
                "text": "Configure the device hostname and IPv4 addressing mode. DHCP is recommended unless a fixed address is required."
              },
              {
                "type": "form",
                "action": "/network/save",
                "children": [
                  {
                    "type": "field",
                    "label": "Host name",
                    "children": [
                      {
                        "type": "input",
                        "name": "hostname",
                        "bind": "network.hostname",
                        "maxLength": 32,
                        "pattern": "[A-Za-z0-9-]+",
                        "required": true
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": "Letters, numbers, and hyphens only."
                  },
                  {
                    "type": "field",
                    "label": "Address mode",
                    "children": [
                      {
                        "type": "select",
                        "name": "mode",
                        "bind": "network.mode",
                        "options": [
                          {
                            "value": "dhcp",
                            "label": "DHCP"
                          },
                          {
                            "value": "static",
                            "label": "STATIC"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "IP address",
                    "children": [
                      {
                        "type": "input",
                        "name": "ip",
                        "bind": "network.ip"
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "Gateway",
                    "children": [
                      {
                        "type": "input",
                        "name": "gateway",
                        "bind": "network.gateway"
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "Subnet mask",
                    "children": [
                      {
                        "type": "input",
                        "name": "subnet",
                        "bind": "network.subnet"
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "DNS 1",
                    "children": [
                      {
                        "type": "input",
                        "name": "dns1",
                        "bind": "network.dns1"
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "DNS 2",
                    "children": [
                      {
                        "type": "input",
                        "name": "dns2",
                        "bind": "network.dns2"
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "text": "Save network settings",
                    "submit": true
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "label": "LIVE CONNECTION",
            "children": [
              {
                "type": "status",
                "label": "Wi-Fi",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "IP address",
                "bind": "network.ip"
              },
              {
                "type": "value",
                "label": "Gateway",
                "bind": "network.gateway"
              },
              {
                "type": "value",
                "label": "Subnet",
                "bind": "network.subnet"
              },
              {
                "type": "value",
                "label": "DNS 1",
                "bind": "network.dns1"
              },
              {
                "type": "value",
                "label": "DNS 2",
                "bind": "network.dns2"
              },
              {
                "type": "value",
                "label": "Authentication",
                "bind": "network.auth"
              },
              {
                "type": "value",
                "label": "BSSID",
                "bind": "network.bssid"
              },
              {
                "type": "value",
                "label": "RSSI",
                "bind": "wifi.rssi",
                "format": "dbm"
              },
              {
                "type": "text",
                "text": "Live values reflect the active connection. Configuration fields above represent values waiting to be saved."
              }
            ]
          }
        ]
      }
    },
    "diagnostics": {
      "title": "DIAGNOSTICS",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(12,minmax(0,1fr))",
        "gap": "16px",
        "children": [
          {
            "type": "relay-dock"
          },
          {
            "type": "panel",
            "label": "DIAGNOSTIC CONTROL",
            "children": [
              {
                "type": "status",
                "label": "Diagnostics",
                "bind": "diagnostics.enabled",
                "map": {
                  "0": "DISABLED",
                  "1": "ENABLED",
                  "true": "ENABLED",
                  "false": "DISABLED"
                }
              },
              {
                "type": "text",
                "text": "The console mirrors selected diagnostic output sent to the serial terminal. The device retains the most recent 20 lines."
              },
              {
                "type": "button",
                "text": "Toggle diagnostics",
                "action": {
                  "action": "diagnostics.toggle"
                }
              }
            ]
          },
          {
            "type": "panel",
            "label": "LIVE SERIAL CONSOLE",
            "children": [
              {
                "type": "log",
                "bind": "diagnosticsLog"
              },
              {
                "type": "text",
                "text": "The console updates live while this page is open."
              }
            ]
          },
          {
            "type": "panel",
            "label": "CONNECTION SNAPSHOT",
            "children": [
              {
                "type": "value",
                "label": "Wi-Fi state",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "Authentication",
                "bind": "network.auth"
              },
              {
                "type": "value",
                "label": "BSSID",
                "bind": "network.bssid"
              },
              {
                "type": "value",
                "label": "RSSI",
                "bind": "wifi.rssi",
                "format": "dbm"
              }
            ]
          }
        ]
      }
    },
    "relays": {
      "title": "RELAYS",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(12,minmax(0,1fr))",
        "gap": "16px",
        "children": [
          {
            "type": "relay-dock"
          },
          {
            "type": "panel",
            "label": "LIVE RELAY CONTROL",
            "children": [
              {
                "type": "grid",
                "columns": "repeat(2,minmax(0,1fr))",
                "gap": "16px",
                "children": [
                  {
                    "type": "relay",
                    "relay": 0
                  },
                  {
                    "type": "relay",
                    "relay": 1
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "label": "RELAY CONFIGURATION",
            "children": [
              {
                "type": "text",
                "text": "Configure both relays below. One Save button writes both relay configurations."
              },
              {
                "type": "form",
                "action": "/relay/config",
                "children": [
                  {
                    "type": "grid",
                    "columns": "repeat(2,minmax(0,1fr))",
                    "gap": "16px",
                    "children": [
                      {
                        "type": "panel",
                        "label": "RELAY 1 CONFIGURATION",
                        "children": [
                          {
                            "type": "relay-detail",
                            "relay": 0,
                            "gpio": 5
                          },
                          {
                            "type": "field",
                            "label": "Relay name",
                            "children": [
                              {
                                "type": "input",
                                "name": "relay0_name",
                                "bind": "relays[0].name",
                                "maxLength": 32,
                                "required": true
                              }
                            ]
                          },
                          {
                            "type": "field",
                            "label": "Normal contact state",
                            "children": [
                              {
                                "type": "select",
                                "name": "relay0_normal",
                                "bind": "relays[0].normal",
                                "transform": "lower",
                                "options": [
                                  {
                                    "value": "open",
                                    "label": "OPEN"
                                  },
                                  {
                                    "value": "closed",
                                    "label": "CLOSED"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "type": "field",
                            "label": "Activation mode",
                            "children": [
                              {
                                "type": "select",
                                "name": "relay0_mode",
                                "bind": "relays[0].mode",
                                "transform": "lower",
                                "options": [
                                  {
                                    "value": "latched",
                                    "label": "LATCHED"
                                  },
                                  {
                                    "value": "pulse",
                                    "label": "PULSE"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "type": "field",
                            "label": "Pulse duration (ms)",
                            "children": [
                              {
                                "type": "input",
                                "name": "relay0_pulse",
                                "bind": "relays[0].pulse",
                                "inputType": "number",
                                "min": 10,
                                "max": 60000,
                                "step": 1
                              }
                            ]
                          },
                          {
                            "type": "text",
                            "text": "10–60000 ms. The stored default is 250 ms. Pulse duration is used when activation mode is PULSE."
                          }
                        ]
                      },
                      {
                        "type": "panel",
                        "label": "RELAY 2 CONFIGURATION",
                        "children": [
                          {
                            "type": "relay-detail",
                            "relay": 1,
                            "gpio": 6
                          },
                          {
                            "type": "field",
                            "label": "Relay name",
                            "children": [
                              {
                                "type": "input",
                                "name": "relay1_name",
                                "bind": "relays[1].name",
                                "maxLength": 32,
                                "required": true
                              }
                            ]
                          },
                          {
                            "type": "field",
                            "label": "Normal contact state",
                            "children": [
                              {
                                "type": "select",
                                "name": "relay1_normal",
                                "bind": "relays[1].normal",
                                "transform": "lower",
                                "options": [
                                  {
                                    "value": "open",
                                    "label": "OPEN"
                                  },
                                  {
                                    "value": "closed",
                                    "label": "CLOSED"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "type": "field",
                            "label": "Activation mode",
                            "children": [
                              {
                                "type": "select",
                                "name": "relay1_mode",
                                "bind": "relays[1].mode",
                                "transform": "lower",
                                "options": [
                                  {
                                    "value": "latched",
                                    "label": "LATCHED"
                                  },
                                  {
                                    "value": "pulse",
                                    "label": "PULSE"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "type": "field",
                            "label": "Pulse duration (ms)",
                            "children": [
                              {
                                "type": "input",
                                "name": "relay1_pulse",
                                "bind": "relays[1].pulse",
                                "inputType": "number",
                                "min": 10,
                                "max": 60000,
                                "step": 1
                              }
                            ]
                          },
                          {
                            "type": "text",
                            "text": "10–60000 ms. The stored default is 250 ms. Pulse duration is used when activation mode is PULSE."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "text": "Save both relay configurations",
                    "submit": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "storage": {
      "title": "STORAGE",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(12,minmax(0,1fr))",
        "gap": "16px",
        "children": [
          {
            "type": "relay-dock"
          },
          {
            "type": "panel",
            "label": "SPIFFS / WEB FILESYSTEM",
            "children": [
              {
                "type": "text",
                "text": "Browse the Web UI filesystem, inspect files, download them, erase them, or upload a replacement. Core Web UI files should be erased only with care."
              },
              {
                "type": "form",
                "action": "/storage/upload",
                "children": [
                  {
                    "type": "field",
                    "label": "Upload or replace a file",
                    "children": [
                      {
                        "type": "input",
                        "name": "storagefile",
                        "inputType": "file",
                        "required": true
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": "Uploading a file with the same name replaces the existing copy."
                  },
                  {
                    "type": "button",
                    "text": "Upload file",
                    "submit": true
                  }
                ]
              },
              {
                "type": "file-browser"
              }
            ]
          },
          {
            "type": "panel",
            "label": "NVS / PERSISTENT CONFIGURATION",
            "children": [
              {
                "type": "text",
                "text": "Read-only inspection of persistent settings. Sensitive values are masked by the device; use the normal configuration pages to change settings."
              },
              {
                "type": "nvs-browser"
              }
            ]
          },
          {
            "type": "panel",
            "label": "CONFIGURATION BACKUP & RESTORE",
            "children": [
              {
                "type": "text",
                "text": "A backup contains saved Wi-Fi credentials and other NVS configuration. Treat the backup as sensitive."
              },
              {
                "type": "grid",
                "columns": "repeat(2,minmax(0,1fr))",
                "gap": "16px",
                "children": [
                  {
                    "type": "panel",
                    "label": "DOWNLOAD BACKUP",
                    "children": [
                      {
                        "type": "text",
                        "text": "Save the complete current NVS configuration."
                      },
                      {
                        "type": "link",
                        "text": "Download configuration backup",
                        "href": "/config/backup"
                      }
                    ]
                  },
                  {
                    "type": "panel",
                    "label": "RESTORE BACKUP",
                    "children": [
                      {
                        "type": "form",
                        "action": "/config/restore",
                        "children": [
                          {
                            "type": "field",
                            "label": "Backup file",
                            "children": [
                              {
                                "type": "input",
                                "name": "configfile",
                                "inputType": "file",
                                "accept": ".bin,application/octet-stream",
                                "required": true
                              }
                            ]
                          },
                          {
                            "type": "button",
                            "text": "Restore configuration",
                            "submit": true
                          }
                        ]
                      },
                      {
                        "type": "text",
                        "text": "The ESP32-C3 will reboot after a successful restore."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "label": "DANGER ZONE",
            "children": [
              {
                "type": "text",
                "text": "Formatting NVS erases Wi-Fi credentials, TX power, diagnostics, network settings, relay configuration, and other persistent configuration, then reboots the ESP32-C3."
              },
              {
                "type": "form",
                "action": "/nvs/format",
                "children": [
                  {
                    "type": "button",
                    "text": "Format NVS and reboot",
                    "submit": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "system": {
      "title": "SYSTEM",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(12,minmax(0,1fr))",
        "gap": "16px",
        "children": [
          {
            "type": "relay-dock"
          },
          {
            "type": "panel",
            "label": "FIRMWARE & BUILD",
            "children": [
              {
                "type": "value",
                "label": "Repository",
                "bind": "system.repository"
              },
              {
                "type": "value",
                "label": "Firmware build",
                "bind": "system.build"
              },
              {
                "type": "value",
                "label": "Web UI build",
                "bind": "system.webBuild"
              },
              {
                "type": "value",
                "label": "Build date",
                "bind": "system.date"
              },
              {
                "type": "value",
                "label": "ESP-IDF",
                "bind": "system.idf"
              },
              {
                "type": "value",
                "label": "Arduino core",
                "bind": "system.arduino"
              },
              {
                "type": "value",
                "label": "Chip",
                "bind": "system.chip"
              },
              {
                "type": "value",
                "label": "CPU frequency",
                "bind": "system.cpu",
                "format": "number"
              },
              {
                "type": "value",
                "label": "Uptime",
                "bind": "system.uptime",
                "format": "number"
              }
            ]
          },
          {
            "type": "panel",
            "label": "PRESENTATION",
            "children": [
              {
                "type": "text",
                "text": "Switch the presentation layer. Built-in and V1 themes remain protected; Nebula V2 is the external DOM V2 presentation."
              },
              {
                "type": "value",
                "label": "Saved UI",
                "bind": "system.uiSelection"
              },
              {
                "type": "button",
                "text": "Use Built-in UI",
                "action": {
                  "action": "ui.select",
                  "args": {
                    "id": "builtin"
                  }
                }
              },
              {
                "type": "button",
                "text": "Use LCARS Modern",
                "action": {
                  "action": "ui.select",
                  "args": {
                    "id": "lcars"
                  }
                }
              },
              {
                "type": "button",
                "text": "Use The Matrix",
                "action": {
                  "action": "ui.select",
                  "args": {
                    "id": "matrix"
                  }
                }
              },
              {
                "type": "button",
                "text": "Use Nebula V2",
                "action": {
                  "action": "ui.select",
                  "args": {
                    "id": "nebula-v2"
                  }
                }
              }
            ]
          },
          {
            "type": "panel",
            "label": "COLOR THEME",
            "children": [
              {
                "type": "text",
                "text": "Choose the built-in color palette. The selection is saved immediately when changed."
              },
              {
                "type": "form",
                "action": "/system/theme",
                "children": [
                  {
                    "type": "field",
                    "label": "Color theme",
                    "children": [
                      {
                        "type": "select",
                        "name": "theme",
                        "bind": "system.theme",
                        "options": [
                          {
                            "value": "0",
                            "label": "Midnight"
                          },
                          {
                            "value": "1",
                            "label": "Ocean"
                          },
                          {
                            "value": "2",
                            "label": "Forest"
                          },
                          {
                            "value": "3",
                            "label": "Emerald"
                          },
                          {
                            "value": "4",
                            "label": "Sunset"
                          },
                          {
                            "value": "5",
                            "label": "Amber"
                          },
                          {
                            "value": "6",
                            "label": "Rose"
                          },
                          {
                            "value": "7",
                            "label": "Purple"
                          },
                          {
                            "value": "8",
                            "label": "Violet"
                          },
                          {
                            "value": "9",
                            "label": "Cyber"
                          },
                          {
                            "value": "10",
                            "label": "Slate"
                          },
                          {
                            "value": "11",
                            "label": "Coffee"
                          },
                          {
                            "value": "12",
                            "label": "Arctic"
                          },
                          {
                            "value": "13",
                            "label": "Sakura"
                          },
                          {
                            "value": "14",
                            "label": "Terminal"
                          },
                          {
                            "value": "15",
                            "label": "Solarized"
                          },
                          {
                            "value": "16",
                            "label": "Monochrome"
                          },
                          {
                            "value": "17",
                            "label": "Crimson"
                          },
                          {
                            "value": "18",
                            "label": "Indigo"
                          },
                          {
                            "value": "19",
                            "label": "Teal"
                          },
                          {
                            "value": "20",
                            "label": "Original"
                          }
                        ],
                        "submitOnChange": true
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "label": "SOFTWARE UPDATE",
            "children": [
              {
                "type": "text",
                "text": "Check GitHub for newer firmware and Web UI components. The update system treats the two components independently."
              },
              {
                "type": "form",
                "action": "/system/update-latest",
                "children": [
                  {
                    "type": "button",
                    "text": "Check for and install updates",
                    "submit": true
                  }
                ]
              },
              {
                "type": "text",
                "text": "The ESP32-C3 may reboot during installation. Keep this page open until the device returns."
              }
            ]
          },
          {
            "type": "panel",
            "label": "MANUAL FIRMWARE UPDATE",
            "children": [
              {
                "type": "text",
                "text": "Upload a compatible firmware .bin image for the ESP32-C3 OTA firmware partition. NVS configuration is preserved."
              },
              {
                "type": "form",
                "action": "/system/update",
                "children": [
                  {
                    "type": "field",
                    "label": "Firmware image",
                    "children": [
                      {
                        "type": "input",
                        "name": "firmware",
                        "inputType": "file",
                        "accept": ".bin,application/octet-stream",
                        "required": true
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "text": "Upgrade firmware",
                    "submit": true
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "label": "MANUAL WEB UI UPDATE",
            "children": [
              {
                "type": "text",
                "text": "Upload the complete SPIFFS Web UI image. Published Web UI images use the -spiffs.bin suffix."
              },
              {
                "type": "form",
                "action": "/system/update-web",
                "children": [
                  {
                    "type": "field",
                    "label": "Web UI filesystem image",
                    "children": [
                      {
                        "type": "input",
                        "name": "web-filesystem",
                        "inputType": "file",
                        "accept": ".bin,application/octet-stream",
                        "required": true
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "text": "Upgrade Web UI",
                    "submit": true
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "label": "SYSTEM ACTIONS",
            "children": [
              {
                "type": "form",
                "action": "/system/reboot",
                "children": [
                  {
                    "type": "button",
                    "text": "Reboot ESP32-C3",
                    "submit": true
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "label": "RECOVERY",
            "children": [
              {
                "type": "text",
                "text": "Use the standalone recovery updater if the normal Web UI becomes unusable."
              },
              {
                "type": "link",
                "text": "Open Recovery Updater",
                "href": "/recovery",
                "target": "_blank"
              }
            ]
          }
        ]
      }
    }
  },
  "description": "Nebula V2 is a GitHub-hosted DOM V2 presentation redesigned around the protected built-in UI's actual information architecture, controls, forms, and operational groupings.",
  "v2Tools": [
    "relay-dock",
    "relay-detail",
    "field",
    "secret",
    "wifi-scanner",
    "file-browser",
    "nvs-browser"
  ]
}
