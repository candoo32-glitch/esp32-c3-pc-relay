{
  "version": 2,
  "name": "Nebula V2",
  "responsive": true,
  "defaultView": "dashboard",
  "tokens": {
    "accent": "#67d9ff",
    "panel": "rgba(14,22,40,.96)",
    "surface": "rgba(22,34,58,.94)",
    "border": "#34547e",
    "radius": "12px",
    "panelPadding": "16px"
  },
  "views": {
    "dashboard": {
      "title": "NEBULA // COMMAND",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(4,minmax(0,1fr))",
        "gap": "12px",
        "children": [
          {
            "type": "panel",
            "label": "SYSTEM",
            "children": [
              {
                "type": "value",
                "label": "Firmware",
                "bind": "system.build"
              },
              {
                "type": "value",
                "label": "Web UI",
                "bind": "system.webBuild"
              },
              {
                "type": "value",
                "label": "CPU",
                "bind": "system.cpu",
                "format": "number"
              },
              {
                "type": "value",
                "label": "Uptime",
                "bind": "system.uptime",
                "format": "number"
              },
              {
                "type": "value",
                "label": "ESP-IDF",
                "bind": "system.idf"
              }
            ]
          },
          {
            "type": "panel",
            "label": "WI-FI",
            "children": [
              {
                "type": "value",
                "label": "Status",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "SSID",
                "bind": "wifi.ssid"
              },
              {
                "type": "value",
                "label": "IP",
                "bind": "wifi.ip"
              },
              {
                "type": "value",
                "label": "RSSI",
                "bind": "wifi.rssi",
                "format": "dbm"
              },
              {
                "type": "value",
                "label": "Channel",
                "bind": "wifi.channel"
              }
            ]
          },
          {
            "type": "gauge",
            "label": "CPU MHz",
            "bind": "system.cpu",
            "min": 0,
            "max": 240,
            "format": "number"
          },
          {
            "type": "meter",
            "label": "SIGNAL STRENGTH",
            "bind": "wifi.rssi",
            "min": -100,
            "max": 0
          },
          {
            "type": "panel",
            "label": "RELAY 1",
            "children": [
              {
                "type": "relay",
                "relay": 0
              }
            ]
          },
          {
            "type": "panel",
            "label": "RELAY 2",
            "children": [
              {
                "type": "relay",
                "relay": 1
              }
            ]
          },
          {
            "type": "panel",
            "label": "NETWORK",
            "children": [
              {
                "type": "value",
                "label": "IP",
                "bind": "network.ip"
              },
              {
                "type": "value",
                "label": "Gateway",
                "bind": "network.gateway"
              },
              {
                "type": "value",
                "label": "Subnet",
                "bind": "network.subnet"
              },
              {
                "type": "value",
                "label": "DNS 1",
                "bind": "network.dns1"
              },
              {
                "type": "value",
                "label": "DNS 2",
                "bind": "network.dns2"
              }
            ]
          },
          {
            "type": "panel",
            "label": "QUICK CONTROLS",
            "children": [
              {
                "type": "button",
                "text": "Reconnect Wi-Fi",
                "action": {
                  "action": "wifi.reconnect"
                }
              },
              {
                "type": "button",
                "text": "Wi-Fi On / Off",
                "action": {
                  "action": "wifi.toggle"
                }
              },
              {
                "type": "button",
                "text": "Reboot ESP32-C3",
                "action": {
                  "action": "system.reboot"
                }
              }
            ]
          }
        ]
      }
    },
    "wifi": {
      "title": "WI-FI",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(2,minmax(0,1fr))",
        "gap": "12px",
        "children": [
          {
            "type": "panel",
            "label": "CONNECTION",
            "children": [
              {
                "type": "value",
                "label": "Status",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "SSID",
                "bind": "wifi.ssid"
              },
              {
                "type": "value",
                "label": "IP address",
                "bind": "wifi.ip"
              },
              {
                "type": "value",
                "label": "Gateway",
                "bind": "wifi.gateway"
              },
              {
                "type": "value",
                "label": "Subnet",
                "bind": "wifi.subnet"
              },
              {
                "type": "value",
                "label": "DNS",
                "bind": "wifi.dns"
              },
              {
                "type": "value",
                "label": "BSSID",
                "bind": "wifi.bssid"
              },
              {
                "type": "value",
                "label": "RSSI",
                "bind": "wifi.rssi",
                "format": "dbm"
              },
              {
                "type": "value",
                "label": "TX power",
                "bind": "wifi.tx"
              },
              {
                "type": "button",
                "text": "Wi-Fi On / Off",
                "action": {
                  "action": "wifi.toggle"
                }
              },
              {
                "type": "button",
                "text": "Reconnect now",
                "action": {
                  "action": "wifi.reconnect"
                }
              }
            ]
          },
          {
            "type": "panel",
            "label": "CREDENTIALS",
            "children": [
              {
                "type": "form",
                "action": "/wifi/save",
                "children": [
                  {
                    "type": "input",
                    "name": "ssid",
                    "bind": "wifi.savedSsid",
                    "placeholder": "Network name",
                    "required": true,
                    "maxLength": 32
                  },
                  {
                    "type": "input",
                    "name": "password",
                    "inputType": "password",
                    "placeholder": "Leave blank for open network",
                    "maxLength": 63
                  },
                  {
                    "type": "button",
                    "text": "Test and save credentials",
                    "submit": true
                  }
                ]
              },
              {
                "type": "text",
                "text": "The saved password is never exposed to DOM V2."
              }
            ]
          },
          {
            "type": "panel",
            "label": "DISCOVERY",
            "children": [
              {
                "type": "button",
                "text": "Scan Wi-Fi",
                "action": {
                  "action": "wifi.scan"
                }
              },
              {
                "type": "text",
                "text": "Scan temporarily pauses normal Wi-Fi connection activity while results are collected."
              },
              {
                "type": "link",
                "text": "Open built-in Wi-Fi scanner",
                "href": "#wifi"
              }
            ]
          },
          {
            "type": "panel",
            "label": "RADIO POWER",
            "children": [
              {
                "type": "form",
                "action": "/wifi/txpower",
                "children": [
                  {
                    "type": "input",
                    "name": "dbm",
                    "bind": "wifi.tx",
                    "inputType": "number",
                    "min": 2,
                    "max": 18,
                    "step": 0.25
                  },
                  {
                    "type": "button",
                    "text": "Save TX power",
                    "submit": true
                  }
                ]
              },
              {
                "type": "text",
                "text": "Allowed range: 2.00–18.00 dBm in 0.25 dBm steps."
              }
            ]
          }
        ]
      }
    },
    "network": {
      "title": "NETWORK",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(2,minmax(0,1fr))",
        "gap": "12px",
        "children": [
          {
            "type": "panel",
            "label": "LIVE CONNECTION",
            "children": [
              {
                "type": "value",
                "label": "Wi-Fi",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "IP address",
                "bind": "network.ip"
              },
              {
                "type": "value",
                "label": "Gateway",
                "bind": "network.gateway"
              },
              {
                "type": "value",
                "label": "Subnet",
                "bind": "network.subnet"
              },
              {
                "type": "value",
                "label": "DNS 1",
                "bind": "network.dns1"
              },
              {
                "type": "value",
                "label": "DNS 2",
                "bind": "network.dns2"
              },
              {
                "type": "value",
                "label": "RSSI",
                "bind": "wifi.rssi",
                "format": "dbm"
              },
              {
                "type": "value",
                "label": "Authentication",
                "bind": "network.auth"
              },
              {
                "type": "value",
                "label": "BSSID",
                "bind": "network.bssid"
              }
            ]
          },
          {
            "type": "panel",
            "label": "CONFIGURATION",
            "children": [
              {
                "type": "form",
                "action": "/network/save",
                "children": [
                  {
                    "type": "input",
                    "name": "hostname",
                    "bind": "network.hostname",
                    "maxLength": 32,
                    "placeholder": "device-name"
                  },
                  {
                    "type": "select",
                    "name": "mode",
                    "bind": "network.mode",
                    "options": [
                      {
                        "value": "dhcp",
                        "label": "DHCP"
                      },
                      {
                        "value": "static",
                        "label": "STATIC"
                      }
                    ]
                  },
                  {
                    "type": "input",
                    "name": "ip",
                    "bind": "network.ip",
                    "placeholder": "192.168.1.50"
                  },
                  {
                    "type": "input",
                    "name": "gateway",
                    "bind": "network.gateway"
                  },
                  {
                    "type": "input",
                    "name": "subnet",
                    "bind": "network.subnet"
                  },
                  {
                    "type": "input",
                    "name": "dns1",
                    "bind": "network.dns1"
                  },
                  {
                    "type": "input",
                    "name": "dns2",
                    "bind": "network.dns2"
                  },
                  {
                    "type": "button",
                    "text": "Save network settings",
                    "submit": true
                  }
                ]
              },
              {
                "type": "text",
                "text": "DHCP is recommended unless the device needs a fixed address."
              }
            ]
          }
        ]
      }
    },
    "diagnostics": {
      "title": "DIAGNOSTICS",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "1fr",
        "gap": "12px",
        "children": [
          {
            "type": "panel",
            "label": "DIAGNOSTIC STATE",
            "children": [
              {
                "type": "status",
                "label": "Diagnostics",
                "bind": "diagnostics.enabled",
                "map": {
                  "0": "DISABLED",
                  "1": "ENABLED",
                  "true": "ENABLED",
                  "false": "DISABLED"
                }
              },
              {
                "type": "button",
                "text": "Toggle diagnostics",
                "action": {
                  "action": "diagnostics.toggle"
                }
              }
            ]
          },
          {
            "type": "panel",
            "label": "LIVE SERIAL CONSOLE",
            "children": [
              {
                "type": "log",
                "bind": "diagnosticsLog"
              }
            ]
          },
          {
            "type": "panel",
            "label": "CONNECTION SNAPSHOT",
            "children": [
              {
                "type": "value",
                "label": "Wi-Fi state",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "Authentication",
                "bind": "network.auth"
              },
              {
                "type": "value",
                "label": "BSSID",
                "bind": "network.bssid"
              },
              {
                "type": "value",
                "label": "RSSI",
                "bind": "wifi.rssi",
                "format": "dbm"
              }
            ]
          }
        ]
      }
    },
    "relays": {
      "title": "RELAYS",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(2,minmax(0,1fr))",
        "gap": "12px",
        "children": [
          {
            "type": "relay",
            "relay": 0
          },
          {
            "type": "relay",
            "relay": 1
          },
          {
            "type": "panel",
            "label": "RELAY CONFIGURATION",
            "children": [
              {
                "type": "form",
                "action": "/relay/config",
                "children": [
                  {
                    "type": "input",
                    "name": "relay0_name",
                    "bind": "relays[0].name",
                    "maxLength": 32,
                    "placeholder": "Relay 1"
                  },
                  {
                    "type": "select",
                    "name": "relay0_normal",
                    "bind": "relays[0].normal",
                    "options": [
                      {
                        "value": "open",
                        "label": "OPEN"
                      },
                      {
                        "value": "closed",
                        "label": "CLOSED"
                      }
                    ]
                  },
                  {
                    "type": "select",
                    "name": "relay0_mode",
                    "bind": "relays[0].mode",
                    "options": [
                      {
                        "value": "latched",
                        "label": "LATCHED"
                      },
                      {
                        "value": "pulse",
                        "label": "PULSE"
                      }
                    ]
                  },
                  {
                    "type": "input",
                    "name": "relay0_pulse",
                    "bind": "relays[0].pulse",
                    "inputType": "number",
                    "min": 10,
                    "max": 60000,
                    "step": 1
                  },
                  {
                    "type": "input",
                    "name": "relay1_name",
                    "bind": "relays[1].name",
                    "maxLength": 32,
                    "placeholder": "Relay 2"
                  },
                  {
                    "type": "select",
                    "name": "relay1_normal",
                    "bind": "relays[1].normal",
                    "options": [
                      {
                        "value": "open",
                        "label": "OPEN"
                      },
                      {
                        "value": "closed",
                        "label": "CLOSED"
                      }
                    ]
                  },
                  {
                    "type": "select",
                    "name": "relay1_mode",
                    "bind": "relays[1].mode",
                    "options": [
                      {
                        "value": "latched",
                        "label": "LATCHED"
                      },
                      {
                        "value": "pulse",
                        "label": "PULSE"
                      }
                    ]
                  },
                  {
                    "type": "input",
                    "name": "relay1_pulse",
                    "bind": "relays[1].pulse",
                    "inputType": "number",
                    "min": 10,
                    "max": 60000,
                    "step": 1
                  },
                  {
                    "type": "button",
                    "text": "Save both relay configurations",
                    "submit": true
                  }
                ]
              },
              {
                "type": "text",
                "text": "Pulse duration: 10–60000 ms. Blank/default is 250 ms."
              }
            ]
          }
        ]
      }
    },
    "storage": {
      "title": "STORAGE",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(2,minmax(0,1fr))",
        "gap": "12px",
        "children": [
          {
            "type": "panel",
            "label": "NVS STATUS",
            "children": [
              {
                "type": "value",
                "label": "Partition size",
                "bind": "nvs.size",
                "format": "number"
              },
              {
                "type": "value",
                "label": "Used entries",
                "bind": "nvs.used",
                "format": "number"
              },
              {
                "type": "value",
                "label": "Free entries",
                "bind": "nvs.free",
                "format": "number"
              },
              {
                "type": "link",
                "text": "Download configuration backup",
                "href": "/config/backup"
              }
            ]
          },
          {
            "type": "panel",
            "label": "FILESYSTEM",
            "children": [
              {
                "type": "form",
                "action": "/storage/upload",
                "children": [
                  {
                    "type": "input",
                    "name": "storagefile",
                    "inputType": "file",
                    "required": true
                  },
                  {
                    "type": "button",
                    "text": "Upload / replace file",
                    "submit": true
                  }
                ]
              },
              {
                "type": "link",
                "text": "Open Recovery Updater",
                "href": "/recovery",
                "target": "_blank"
              }
            ]
          },
          {
            "type": "panel",
            "label": "CONFIGURATION BACKUP",
            "children": [
              {
                "type": "link",
                "text": "Download backup",
                "href": "/config/backup"
              },
              {
                "type": "form",
                "action": "/config/restore",
                "children": [
                  {
                    "type": "input",
                    "name": "configfile",
                    "inputType": "file",
                    "required": true
                  },
                  {
                    "type": "button",
                    "text": "Restore & reboot",
                    "submit": true
                  }
                ]
              },
              {
                "type": "text",
                "text": "Backups contain saved configuration and Wi-Fi credentials; treat them as sensitive."
              }
            ]
          },
          {
            "type": "panel",
            "label": "DANGER ZONE",
            "children": [
              {
                "type": "text",
                "text": "Erase persistent NVS configuration, including Wi-Fi and network settings, then reboot."
              },
              {
                "type": "form",
                "action": "/nvs/format",
                "children": [
                  {
                    "type": "button",
                    "text": "Format NVS and reboot",
                    "submit": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "system": {
      "title": "SYSTEM",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(2,minmax(0,1fr))",
        "gap": "12px",
        "children": [
          {
            "type": "panel",
            "label": "FIRMWARE",
            "children": [
              {
                "type": "value",
                "label": "Repository",
                "bind": "system.repository"
              },
              {
                "type": "value",
                "label": "Firmware build",
                "bind": "system.build"
              },
              {
                "type": "value",
                "label": "Web UI",
                "bind": "system.webBuild"
              },
              {
                "type": "value",
                "label": "Build date",
                "bind": "system.date"
              },
              {
                "type": "value",
                "label": "ESP-IDF",
                "bind": "system.idf"
              },
              {
                "type": "value",
                "label": "Arduino",
                "bind": "system.arduino"
              },
              {
                "type": "value",
                "label": "Chip",
                "bind": "system.chip"
              },
              {
                "type": "value",
                "label": "CPU",
                "bind": "system.cpu",
                "format": "number"
              },
              {
                "type": "value",
                "label": "Uptime",
                "bind": "system.uptime",
                "format": "number"
              }
            ]
          },
          {
            "type": "panel",
            "label": "PRESENTATION",
            "children": [
              {
                "type": "text",
                "text": "Switching presentation reloads the page so the previous UI runtime is completely discarded."
              },
              {
                "type": "button",
                "text": "Built-in UI",
                "action": {
                  "action": "ui.select",
                  "args": {
                    "id": "builtin"
                  }
                }
              },
              {
                "type": "button",
                "text": "LCARS V1",
                "action": {
                  "action": "ui.select",
                  "args": {
                    "id": "lcars"
                  }
                }
              },
              {
                "type": "button",
                "text": "Matrix V1",
                "action": {
                  "action": "ui.select",
                  "args": {
                    "id": "matrix"
                  }
                }
              },
              {
                "type": "button",
                "text": "Nebula V2",
                "action": {
                  "action": "ui.select",
                  "args": {
                    "id": "nebula-v2"
                  }
                }
              }
            ]
          },
          {
            "type": "panel",
            "label": "SYSTEM ACTIONS",
            "children": [
              {
                "type": "button",
                "text": "Check and install updates",
                "action": {
                  "action": "ota.latest"
                }
              },
              {
                "type": "button",
                "text": "Reboot ESP32-C3",
                "action": {
                  "action": "system.reboot"
                }
              },
              {
                "type": "link",
                "text": "Open Recovery Updater",
                "href": "/recovery",
                "target": "_blank"
              }
            ]
          },
          {
            "type": "panel",
            "label": "COLOR THEME",
            "children": [
              {
                "type": "form",
                "action": "/system/theme",
                "children": [
                  {
                    "type": "select",
                    "name": "theme",
                    "bind": "system.theme",
                    "options": [
                      {
                        "value": "0",
                        "label": "Midnight"
                      },
                      {
                        "value": "1",
                        "label": "Ocean"
                      },
                      {
                        "value": "2",
                        "label": "Forest"
                      },
                      {
                        "value": "3",
                        "label": "Emerald"
                      },
                      {
                        "value": "4",
                        "label": "Sunset"
                      },
                      {
                        "value": "5",
                        "label": "Amber"
                      },
                      {
                        "value": "6",
                        "label": "Rose"
                      },
                      {
                        "value": "7",
                        "label": "Purple"
                      },
                      {
                        "value": "8",
                        "label": "Violet"
                      },
                      {
                        "value": "9",
                        "label": "Cyber"
                      },
                      {
                        "value": "10",
                        "label": "Slate"
                      },
                      {
                        "value": "11",
                        "label": "Coffee"
                      },
                      {
                        "value": "12",
                        "label": "Arctic"
                      },
                      {
                        "value": "13",
                        "label": "Sakura"
                      },
                      {
                        "value": "14",
                        "label": "Terminal"
                      },
                      {
                        "value": "15",
                        "label": "Solarized"
                      },
                      {
                        "value": "16",
                        "label": "Monochrome"
                      },
                      {
                        "value": "17",
                        "label": "Crimson"
                      },
                      {
                        "value": "18",
                        "label": "Indigo"
                      },
                      {
                        "value": "19",
                        "label": "Teal"
                      },
                      {
                        "value": "20",
                        "label": "Original"
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "text": "Apply color theme",
                    "submit": true
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
