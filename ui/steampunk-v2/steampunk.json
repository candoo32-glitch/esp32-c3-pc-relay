{
  "version": 2,
  "name": "Steampunk",
  "responsive": true,
  "defaultView": "dashboard",
  "tokens": {
    "accent": "#d59a43",
    "panel": "#17130f",
    "surface": "#241c14",
    "border": "#8c5d2d",
    "radius": "5px",
    "panelPadding": "16px",
    "brass": "#c7924e"
  },
  "views": {
    "dashboard": {
      "title": "ESP32-C3 // STEAMPUNK CONTROL DECK",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(12,minmax(0,1fr))",
        "gap": "14px",
        "children": [
          {
            "type": "image",
            "class": "dashboard-art",
            "src": "https://raw.githubusercontent.com/candoo32-glitch/esp32-c3-pc-relay/3df5d9597b1c03d97f9239b4fd2368c6f69c4bd5/ui/steampunk-v2/steampunk-dashboard.svg",
            "alt": ""
          },
          {
            "type": "panel",
            "class": "masthead span-12",
            "label": "STEAMPUNK CONTROL DECK",
            "children": [
              {
                "type": "container",
                "class": "chassis-tubes tubes-left",
                "children": []
              },
              {
                "type": "container",
                "class": "chassis-tubes tubes-right",
                "children": []
              },
              {
                "type": "grid",
                "columns": "repeat(3,minmax(64px,1fr))",
                "class": "nixie-strip",
                "children": [
                  {
                    "type": "value",
                    "class": "nixie-digit",
                    "label": "BUILD",
                    "bind": "system.build",
                    "animate": "glow"
                  },
                  {
                    "type": "value",
                    "class": "nixie-digit",
                    "label": "CPU",
                    "bind": "system.cpu",
                    "format": "number",
                    "animate": "glow"
                  },
                  {
                    "type": "value",
                    "class": "nixie-digit",
                    "label": "UPTIME",
                    "bind": "system.uptime",
                    "format": "number",
                    "animate": "glow"
                  }
                ]
              },
              {
                "type": "text",
                "class": "masthead-title",
                "text": "ESP32-C3 RELAY CONTROLLER"
              },
              {
                "type": "grid",
                "columns": "repeat(3,minmax(0,1fr))",
                "class": "masthead-meta",
                "children": [
                  {
                    "type": "value",
                    "label": "BUILD",
                    "bind": "system.build"
                  },
                  {
                    "type": "value",
                    "label": "UPTIME",
                    "bind": "system.uptime",
                    "format": "number"
                  },
                  {
                    "type": "value",
                    "label": "DATE / TIME",
                    "bind": "system.date"
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "class": "system-status span-7",
            "label": "SYSTEM STATUS",
            "children": [
              {
                "type": "status",
                "label": "Controller",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "Hostname",
                "bind": "network.hostname"
              },
              {
                "type": "value",
                "label": "IP Address",
                "bind": "network.ip"
              },
              {
                "type": "value",
                "label": "Gateway",
                "bind": "network.gateway"
              },
              {
                "type": "value",
                "label": "DNS 1",
                "bind": "network.dns1"
              },
              {
                "type": "value",
                "label": "DNS 2",
                "bind": "network.dns2"
              },
              {
                "type": "value",
                "label": "CPU Clock",
                "bind": "system.cpu",
                "format": "number"
              },
              {
                "type": "value",
                "label": "ESP-IDF",
                "bind": "system.idf"
              }
            ]
          },
          {
            "type": "panel",
            "class": "wireless-status span-5",
            "label": "WIRELESS",
            "children": [
              {
                "type": "status",
                "label": "Connection",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "SSID",
                "bind": "wifi.ssid"
              },
              {
                "type": "value",
                "label": "RSSI",
                "bind": "wifi.rssi",
                "format": "dbm"
              },
              {
                "type": "value",
                "label": "Channel",
                "bind": "wifi.channel"
              },
              {
                "type": "value",
                "label": "TX Power",
                "bind": "wifi.tx",
                "format": "number"
              },
              {
                "type": "meter",
                "label": "SIGNAL",
                "bind": "wifi.rssi",
                "min": -100,
                "max": 0
              },
              {
                "type": "grid",
                "columns": "repeat(2,minmax(0,1fr))",
                "class": "action-row",
                "children": [
                  {
                    "type": "button",
                    "text": "RECONNECT",
                    "class": "secondary",
                    "action": {
                      "action": "wifi.reconnect"
                    }
                  },
                  {
                    "type": "button",
                    "text": "WI-FI ON / OFF",
                    "class": "secondary",
                    "action": {
                      "action": "wifi.toggle"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "class": "instrument-panel span-3",
            "label": "INSTRUMENTS",
            "children": [
              {
                "type": "gauge",
                "label": "CPU CLOCK",
                "bind": "system.cpu",
                "min": 0,
                "max": 240,
                "format": "number"
              },
              {
                "type": "value",
                "label": "Uptime (s)",
                "bind": "system.uptime",
                "format": "number"
              },
              {
                "type": "value",
                "label": "Web UI Build",
                "bind": "system.webBuild"
              }
            ]
          },
          {
            "type": "panel",
            "class": "relay-dashboard span-4",
            "label": "RELAY 1",
            "children": [
              {
                "type": "relay",
                "relay": 0
              },
              {
                "type": "relay-detail",
                "relay": 0,
                "gpio": 5
              }
            ]
          },
          {
            "type": "panel",
            "class": "relay-dashboard span-5",
            "label": "RELAY 2",
            "children": [
              {
                "type": "relay",
                "relay": 1
              },
              {
                "type": "relay-detail",
                "relay": 1,
                "gpio": 6
              }
            ]
          },
          {
            "type": "panel",
            "class": "network-summary span-5",
            "label": "NETWORK",
            "children": [
              {
                "type": "value",
                "label": "Mode",
                "bind": "network.mode"
              },
              {
                "type": "value",
                "label": "IP",
                "bind": "network.ip"
              },
              {
                "type": "value",
                "label": "Subnet",
                "bind": "network.subnet"
              },
              {
                "type": "value",
                "label": "Gateway",
                "bind": "network.gateway"
              },
              {
                "type": "value",
                "label": "DNS 1",
                "bind": "network.dns1"
              },
              {
                "type": "value",
                "label": "DNS 2",
                "bind": "network.dns2"
              },
              {
                "type": "value",
                "label": "Authentication",
                "bind": "network.auth"
              }
            ]
          },
          {
            "type": "panel",
            "class": "activity span-7",
            "label": "ACTIVITY LOG",
            "children": [
              {
                "type": "log",
                "bind": "diagnosticsLog"
              }
            ]
          },
          {
            "type": "container",
            "class": "gear-decor gear-one",
            "children": []
          },
          {
            "type": "container",
            "class": "gear-decor gear-two",
            "children": []
          }
        ]
      }
    },
    "wifi": {
      "title": "WI-FI",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(12,minmax(0,1fr))",
        "gap": "14px",
        "children": [
          {
            "type": "panel",
            "class": "connection-card span-5",
            "label": "CURRENT CONNECTION",
            "children": [
              {
                "type": "status",
                "label": "Status",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "SSID",
                "bind": "wifi.ssid"
              },
              {
                "type": "value",
                "label": "IP Address",
                "bind": "wifi.ip"
              },
              {
                "type": "value",
                "label": "Gateway",
                "bind": "wifi.gateway"
              },
              {
                "type": "value",
                "label": "Subnet",
                "bind": "wifi.subnet"
              },
              {
                "type": "value",
                "label": "DNS",
                "bind": "wifi.dns"
              },
              {
                "type": "value",
                "label": "BSSID",
                "bind": "wifi.bssid"
              },
              {
                "type": "value",
                "label": "RSSI",
                "bind": "wifi.rssi",
                "format": "dbm"
              },
              {
                "type": "value",
                "label": "Channel",
                "bind": "wifi.channel"
              },
              {
                "type": "value",
                "label": "TX Power",
                "bind": "wifi.tx",
                "format": "number"
              },
              {
                "type": "grid",
                "columns": "repeat(2,minmax(0,1fr))",
                "class": "action-row",
                "children": [
                  {
                    "type": "button",
                    "text": "RECONNECT",
                    "action": {
                      "action": "wifi.reconnect"
                    }
                  },
                  {
                    "type": "button",
                    "text": "WI-FI ON / OFF",
                    "action": {
                      "action": "wifi.toggle"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "class": "credentials-card span-7",
            "label": "WI-FI CREDENTIALS",
            "children": [
              {
                "type": "form",
                "action": "/wifi/save",
                "children": [
                  {
                    "type": "field",
                    "label": "NETWORK / SSID",
                    "children": [
                      {
                        "type": "input",
                        "id": "ssid",
                        "name": "ssid",
                        "bind": "wifi.savedSsid",
                        "maxLength": 32,
                        "required": true,
                        "autocomplete": "off"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "class": "form-note",
                    "text": "Enter the network manually or select an access point from the scan below."
                  },
                  {
                    "type": "wifi-scanner",
                    "target": "#v2-ssid"
                  },
                  {
                    "type": "text",
                    "class": "field-heading",
                    "text": "PASSWORD"
                  },
                  {
                    "type": "secret",
                    "name": "password",
                    "savedBind": "wifi.passwordSaved",
                    "placeholder": "********",
                    "maxLength": 63
                  },
                  {
                    "type": "text",
                    "class": "form-note",
                    "text": "A saved password is masked until you edit it. Open networks may leave this field empty."
                  },
                  {
                    "type": "button",
                    "text": "TEST AND SAVE CREDENTIALS",
                    "class": "primary",
                    "submit": true
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "class": "radio-power span-5",
            "label": "RADIO POWER",
            "children": [
              {
                "type": "form",
                "action": "/wifi/txpower",
                "children": [
                  {
                    "type": "field",
                    "label": "TRANSMIT POWER (dBm)",
                    "children": [
                      {
                        "type": "input",
                        "name": "dbm",
                        "bind": "wifi.tx",
                        "inputType": "number",
                        "min": 2,
                        "max": 18,
                        "step": 0.25
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "class": "form-note",
                    "text": "Allowed range: 2.00–18.00 dBm in 0.25 dBm increments."
                  },
                  {
                    "type": "button",
                    "text": "SAVE TX POWER",
                    "class": "primary",
                    "submit": true
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "class": "wifi-note span-7",
            "label": "RADIO NOTES",
            "children": [
              {
                "type": "meter",
                "label": "LIVE SIGNAL",
                "bind": "wifi.rssi",
                "min": -100,
                "max": 0
              },
              {
                "type": "value",
                "label": "Saved SSID",
                "bind": "wifi.savedSsid"
              },
              {
                "type": "status",
                "label": "Wi-Fi State",
                "bind": "wifi.status"
              },
              {
                "type": "text",
                "class": "form-note",
                "text": "Scanning temporarily pauses normal Wi-Fi connection activity while results are collected."
              }
            ]
          }
        ]
      }
    },
    "network": {
      "title": "NETWORK",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(12,minmax(0,1fr))",
        "gap": "14px",
        "children": [
          {
            "type": "panel",
            "class": "network-config span-7",
            "label": "ADDRESSING",
            "children": [
              {
                "type": "text",
                "class": "form-note",
                "text": "DHCP is recommended. Static fields are retained for use whenever STATIC mode is selected."
              },
              {
                "type": "form",
                "action": "/network/save",
                "children": [
                  {
                    "type": "field",
                    "label": "HOST NAME",
                    "children": [
                      {
                        "type": "input",
                        "name": "hostname",
                        "bind": "network.hostname",
                        "maxLength": 32,
                        "pattern": "[A-Za-z0-9-]+",
                        "required": true
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "label": "ADDRESS MODE",
                    "children": [
                      {
                        "type": "select",
                        "name": "mode",
                        "bind": "network.mode",
                        "options": [
                          {
                            "value": "dhcp",
                            "label": "DHCP"
                          },
                          {
                            "value": "static",
                            "label": "STATIC"
                          }
                        ],
                        "transform": "lower"
                      }
                    ]
                  },
                  {
                    "type": "grid",
                    "columns": "repeat(2,minmax(0,1fr))",
                    "class": "static-grid",
                    "children": [
                      {
                        "type": "field",
                        "label": "IP ADDRESS",
                        "children": [
                          {
                            "type": "input",
                            "name": "ip",
                            "bind": "network.ip"
                          }
                        ]
                      },
                      {
                        "type": "field",
                        "label": "GATEWAY",
                        "children": [
                          {
                            "type": "input",
                            "name": "gateway",
                            "bind": "network.gateway"
                          }
                        ]
                      },
                      {
                        "type": "field",
                        "label": "SUBNET MASK",
                        "children": [
                          {
                            "type": "input",
                            "name": "subnet",
                            "bind": "network.subnet"
                          }
                        ]
                      },
                      {
                        "type": "field",
                        "label": "DNS 1",
                        "children": [
                          {
                            "type": "input",
                            "name": "dns1",
                            "bind": "network.dns1"
                          }
                        ]
                      },
                      {
                        "type": "field",
                        "label": "DNS 2",
                        "children": [
                          {
                            "type": "input",
                            "name": "dns2",
                            "bind": "network.dns2"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "text": "SAVE NETWORK SETTINGS",
                    "class": "primary",
                    "submit": true
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "class": "live-network span-5",
            "label": "LIVE CONNECTION",
            "children": [
              {
                "type": "status",
                "label": "Wi-Fi",
                "bind": "wifi.status"
              },
              {
                "type": "value",
                "label": "IP Address",
                "bind": "network.ip"
              },
              {
                "type": "value",
                "label": "Gateway",
                "bind": "network.gateway"
              },
              {
                "type": "value",
                "label": "Subnet",
                "bind": "network.subnet"
              },
              {
                "type": "value",
                "label": "DNS 1",
                "bind": "network.dns1"
              },
              {
                "type": "value",
                "label": "DNS 2",
                "bind": "network.dns2"
              },
              {
                "type": "value",
                "label": "Authentication",
                "bind": "network.auth"
              },
              {
                "type": "value",
                "label": "BSSID",
                "bind": "network.bssid"
              },
              {
                "type": "value",
                "label": "RSSI",
                "bind": "wifi.rssi",
                "format": "dbm"
              }
            ]
          },
          {
            "type": "panel",
            "class": "network-foot span-12",
            "label": "NETWORK IDENTITY",
            "children": [
              {
                "type": "value",
                "label": "Hostname",
                "bind": "network.hostname"
              },
              {
                "type": "value",
                "label": "Mode",
                "bind": "network.mode"
              },
              {
                "type": "text",
                "class": "form-note",
                "text": "The values above are the device's current network identity. Configuration changes are applied by the save operation."
              }
            ]
          }
        ]
      }
    },
    "diagnostics": {
      "title": "DIAGNOSTICS",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(12,minmax(0,1fr))",
        "gap": "14px",
        "children": [
          {
            "type": "panel",
            "class": "diagnostic-control span-4",
            "label": "DIAGNOSTIC CONTROL",
            "children": [
              {
                "type": "status",
                "label": "Diagnostics",
                "bind": "diagnostics.enabled",
                "map": {
                  "0": "DISABLED",
                  "1": "ENABLED",
                  "true": "ENABLED",
                  "false": "DISABLED"
                }
              },
              {
                "type": "text",
                "class": "form-note",
                "text": "The console mirrors selected diagnostic output sent to the serial terminal. The device retains the most recent 20 lines."
              },
              {
                "type": "button",
                "text": "TOGGLE DIAGNOSTICS",
                "class": "primary",
                "action": {
                  "action": "diagnostics.toggle"
                }
              },
              {
                "type": "value",
                "label": "Wi-Fi",
                "bind": "wifi.status"
              }
            ]
          },
          {
            "type": "panel",
            "class": "console span-8",
            "label": "LIVE SERIAL CONSOLE",
            "children": [
              {
                "type": "log",
                "bind": "diagnosticsLog"
              }
            ]
          },
          {
            "type": "panel",
            "class": "connection-snapshot span-12",
            "label": "CONNECTION SNAPSHOT",
            "children": [
              {
                "type": "grid",
                "columns": "repeat(4,minmax(0,1fr))",
                "children": [
                  {
                    "type": "value",
                    "label": "Wi-Fi State",
                    "bind": "wifi.status"
                  },
                  {
                    "type": "value",
                    "label": "Authentication",
                    "bind": "network.auth"
                  },
                  {
                    "type": "value",
                    "label": "BSSID",
                    "bind": "network.bssid"
                  },
                  {
                    "type": "value",
                    "label": "RSSI",
                    "bind": "wifi.rssi",
                    "format": "dbm"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "relays": {
      "title": "RELAYS",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(12,minmax(0,1fr))",
        "gap": "14px",
        "children": [
          {
            "type": "panel",
            "class": "relay-intro span-12",
            "label": "RELAY CONTROL",
            "children": [
              {
                "type": "text",
                "class": "form-note",
                "text": "Both relay channels are independently configurable. The save control below writes both relay configurations together."
              }
            ]
          },
          {
            "type": "form",
            "class": "relay-config span-12",
            "action": "/relay/config",
            "children": [
              {
                "type": "panel",
                "class": "relay-config-card",
                "label": "RELAY 1",
                "children": [
                  {
                    "type": "relay",
                    "relay": 0
                  },
                  {
                    "type": "relay-detail",
                    "relay": 0,
                    "gpio": 5
                  },
                  {
                    "type": "grid",
                    "columns": "repeat(2,minmax(0,1fr))",
                    "children": [
                      {
                        "type": "field",
                        "label": "NAME",
                        "children": [
                          {
                            "type": "input",
                            "name": "relay0_name",
                            "bind": "relays[0].name",
                            "maxLength": 32
                          }
                        ]
                      },
                      {
                        "type": "field",
                        "label": "NORMAL CONTACT STATE",
                        "children": [
                          {
                            "type": "select",
                            "name": "relay0_normal",
                            "bind": "relays[0].normal",
                            "transform": "lower",
                            "options": [
                              {
                                "value": "open",
                                "label": "OPEN"
                              },
                              {
                                "value": "closed",
                                "label": "CLOSED"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "field",
                        "label": "ACTIVATION MODE",
                        "children": [
                          {
                            "type": "select",
                            "name": "relay0_mode",
                            "bind": "relays[0].mode",
                            "transform": "lower",
                            "options": [
                              {
                                "value": "latched",
                                "label": "LATCHED"
                              },
                              {
                                "value": "pulse",
                                "label": "PULSE"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "field",
                        "label": "PULSE DURATION (ms)",
                        "children": [
                          {
                            "type": "input",
                            "name": "relay0_pulse",
                            "bind": "relays[0].pulse",
                            "inputType": "number",
                            "min": 10,
                            "max": 60000,
                            "step": 1
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "panel",
                "class": "relay-config-card",
                "label": "RELAY 2",
                "children": [
                  {
                    "type": "relay",
                    "relay": 1
                  },
                  {
                    "type": "relay-detail",
                    "relay": 1,
                    "gpio": 6
                  },
                  {
                    "type": "grid",
                    "columns": "repeat(2,minmax(0,1fr))",
                    "children": [
                      {
                        "type": "field",
                        "label": "NAME",
                        "children": [
                          {
                            "type": "input",
                            "name": "relay1_name",
                            "bind": "relays[1].name",
                            "maxLength": 32
                          }
                        ]
                      },
                      {
                        "type": "field",
                        "label": "NORMAL CONTACT STATE",
                        "children": [
                          {
                            "type": "select",
                            "name": "relay1_normal",
                            "bind": "relays[1].normal",
                            "transform": "lower",
                            "options": [
                              {
                                "value": "open",
                                "label": "OPEN"
                              },
                              {
                                "value": "closed",
                                "label": "CLOSED"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "field",
                        "label": "ACTIVATION MODE",
                        "children": [
                          {
                            "type": "select",
                            "name": "relay1_mode",
                            "bind": "relays[1].mode",
                            "transform": "lower",
                            "options": [
                              {
                                "value": "latched",
                                "label": "LATCHED"
                              },
                              {
                                "value": "pulse",
                                "label": "PULSE"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "field",
                        "label": "PULSE DURATION (ms)",
                        "children": [
                          {
                            "type": "input",
                            "name": "relay1_pulse",
                            "bind": "relays[1].pulse",
                            "inputType": "number",
                            "min": 10,
                            "max": 60000,
                            "step": 1
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "button",
                "text": "SAVE BOTH RELAY CONFIGURATIONS",
                "class": "primary save-both",
                "submit": true
              }
            ]
          }
        ]
      }
    },
    "storage": {
      "title": "STORAGE",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(12,minmax(0,1fr))",
        "gap": "14px",
        "children": [
          {
            "type": "panel",
            "class": "filesystem span-7",
            "label": "SPIFFS FILESYSTEM",
            "children": [
              {
                "type": "file-browser"
              },
              {
                "type": "form",
                "action": "/storage/upload",
                "children": [
                  {
                    "type": "field",
                    "label": "UPLOAD FILE",
                    "children": [
                      {
                        "type": "input",
                        "name": "file",
                        "inputType": "file"
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "text": "UPLOAD / REPLACE",
                    "class": "primary",
                    "submit": true
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "class": "nvs-panel span-5",
            "label": "NVS INSPECTOR",
            "children": [
              {
                "type": "nvs-browser"
              }
            ]
          },
          {
            "type": "panel",
            "class": "backup span-6",
            "label": "CONFIGURATION BACKUP",
            "children": [
              {
                "type": "text",
                "class": "form-note",
                "text": "Backups include saved configuration. Treat exported files as sensitive because they may contain network credentials."
              },
              {
                "type": "link",
                "text": "DOWNLOAD CONFIGURATION BACKUP",
                "href": "/config/backup"
              },
              {
                "type": "form",
                "action": "/config/restore",
                "children": [
                  {
                    "type": "field",
                    "label": "RESTORE BACKUP",
                    "children": [
                      {
                        "type": "input",
                        "name": "configfile",
                        "inputType": "file",
                        "accept": ".backup"
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "text": "RESTORE CONFIGURATION",
                    "class": "primary",
                    "submit": true
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "class": "danger-zone span-6",
            "label": "DANGER ZONE",
            "children": [
              {
                "type": "text",
                "class": "form-note",
                "text": "Formatting NVS permanently removes saved configuration. Use recovery only when normal operation is no longer sufficient."
              },
              {
                "type": "form",
                "action": "/nvs/format",
                "children": [
                  {
                    "type": "button",
                    "text": "FORMAT NVS",
                    "class": "danger-button",
                    "submit": true
                  }
                ]
              },
              {
                "type": "link",
                "text": "OPEN RECOVERY UPDATER",
                "href": "/recovery"
              }
            ]
          }
        ]
      }
    },
    "system": {
      "title": "SYSTEM",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(12,minmax(0,1fr))",
        "gap": "14px",
        "children": [
          {
            "type": "panel",
            "class": "device-info span-4",
            "label": "DEVICE",
            "children": [
              {
                "type": "value",
                "label": "Firmware Build",
                "bind": "system.build"
              },
              {
                "type": "value",
                "label": "Web UI Build",
                "bind": "system.webBuild"
              },
              {
                "type": "value",
                "label": "ESP-IDF",
                "bind": "system.idf"
              },
              {
                "type": "value",
                "label": "Arduino",
                "bind": "system.arduino"
              },
              {
                "type": "value",
                "label": "CPU",
                "bind": "system.cpu",
                "format": "number"
              },
              {
                "type": "value",
                "label": "Uptime",
                "bind": "system.uptime",
                "format": "number"
              },
              {
                "type": "value",
                "label": "Build Date",
                "bind": "system.date"
              }
            ]
          },
          {
            "type": "panel",
            "class": "presentation span-8",
            "label": "PRESENTATION",
            "children": [
              {
                "type": "value",
                "label": "Saved UI",
                "bind": "system.uiSelection"
              },
              {
                "type": "text",
                "class": "form-note",
                "text": "Presentation changes are applied immediately by switching the page to the selected GitHub-hosted UI."
              },
              {
                "type": "grid",
                "columns": "repeat(4,minmax(0,1fr))",
                "class": "presentation-buttons",
                "children": [
                  {
                    "type": "button",
                    "text": "BUILT-IN",
                    "action": {
                      "action": "ui.select",
                      "args": {
                        "id": "builtin"
                      }
                    }
                  },
                  {
                    "type": "button",
                    "text": "LCARS",
                    "action": {
                      "action": "ui.select",
                      "args": {
                        "id": "lcars"
                      }
                    }
                  },
                  {
                    "type": "button",
                    "text": "MATRIX",
                    "action": {
                      "action": "ui.select",
                      "args": {
                        "id": "matrix"
                      }
                    }
                  },
                  {
                    "type": "button",
                    "text": "STEAMPUNK",
                    "class": "primary",
                    "action": {
                      "action": "ui.select",
                      "args": {
                        "id": "steampunk-v2"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "class": "updates span-6",
            "label": "SOFTWARE UPDATES",
            "children": [
              {
                "type": "text",
                "class": "form-note",
                "text": "Ask GitHub for the latest compatible firmware and Web UI builds."
              },
              {
                "type": "button",
                "text": "CHECK FOR UPDATES",
                "class": "primary",
                "action": {
                  "action": "ota.latest"
                }
              },
              {
                "type": "value",
                "label": "Current Firmware",
                "bind": "system.build"
              },
              {
                "type": "value",
                "label": "Current Web UI",
                "bind": "system.webBuild"
              }
            ]
          },
          {
            "type": "panel",
            "class": "manual-update span-6",
            "label": "MANUAL UPDATE",
            "children": [
              {
                "type": "form",
                "action": "/system/update",
                "children": [
                  {
                    "type": "field",
                    "label": "FIRMWARE IMAGE",
                    "children": [
                      {
                        "type": "input",
                        "name": "firmware",
                        "inputType": "file",
                        "accept": ".bin"
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "text": "UPDATE FIRMWARE",
                    "class": "primary",
                    "submit": true
                  }
                ]
              },
              {
                "type": "form",
                "action": "/system/update-web",
                "children": [
                  {
                    "type": "field",
                    "label": "WEB UI IMAGE",
                    "children": [
                      {
                        "type": "input",
                        "name": "web-filesystem",
                        "inputType": "file",
                        "accept": ".bin"
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "text": "UPDATE WEB UI",
                    "class": "primary",
                    "submit": true
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "class": "system-actions span-12",
            "label": "SYSTEM ACTIONS",
            "children": [
              {
                "type": "grid",
                "columns": "repeat(3,minmax(0,1fr))",
                "children": [
                  {
                    "type": "button",
                    "text": "REBOOT CONTROLLER",
                    "class": "secondary",
                    "action": {
                      "action": "system.reboot"
                    }
                  },
                  {
                    "type": "link",
                    "text": "OPEN RECOVERY UPDATER",
                    "href": "/recovery",
                    "class": "secondary-link"
                  },
                  {
                    "type": "link",
                    "text": "OPEN BUILT-IN ROOT",
                    "href": "/?tab=dashboard",
                    "class": "secondary-link"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
