@echo off
if /I not "%~1"=="__ESP32_INTERNAL" (
"%ComSpec%" /d /c call "%~f0" __ESP32_INTERNAL
exit /b 0
)
setlocal EnableExtensions EnableDelayedExpansion

set "TARGET_BRANCH=__TARGET_BRANCH__"

rem Modern Windows terminal UI: VT sequences provide per-line colors and cursor control.
rem No global COLOR command is used, so the whole console never changes color.
for /f "delims=" %%E in ('echo prompt $E^| cmd') do set "ESC=%%E"
set "VT=!ESC!["
title ESP32-C3 PC Relay Firmware Flasher
<nul set /p "=!VT!?1049h!VT!2J!VT!H!VT!?25l"
call :FLASH_APP
set "FLASH_APP_EXIT=!ERRORLEVEL!"
<nul set /p "=!VT!?25h!VT!0m!VT!?1049l"
endlocal & exit /b !FLASH_APP_EXIT!

:FLASH_APP
call :UI_INIT
call :UI_FIELD 5 "Branch" "!TARGET_BRANCH!"
call :UI_STATUS "Starting flasher..."
call :UI_LOG "Flasher started."
call :UI_FIELD 6 "Build" "checking..."
call :UI_FIELD 11 "Artifact" "waiting..."
call :UI_FIELD 12 "Firmware" "waiting..."
call :UI_FIELD 13 "Run ID" "waiting..."
call :UI_FIELD 14 "Integrity" "pending"
call :UI_FIELD 15 "Image" "pending"
call :UI_FIELD 18 "Device" "ESP32-C3"
call :UI_FIELD 19 "Stage" "Starting"
call :UI_PROGRESS 0 "Initializing"
call :UI_FIELD 21 "Detail" "Ready"
call :UI_LOG "Dashboard initialized."
call :UI_STATUS "Checking prerequisites..."
call :UI_LOG "Checking GitHub CLI and Python."
where gh >nul 2>&1
if errorlevel 1 (
echo ERROR: GitHub CLI ^(gh^) was not found.
    echo Install GitHub CLI before using this flasher.
    echo.
    pause
    exit /b 1
)
where py >nul 2>&1
if errorlevel 1 (
echo ERROR: Python launcher ^(py^) was not found.
    echo Install Python for Windows with the py launcher enabled.
    echo.
    pause
    exit /b 1
)

if not defined GH_TOKEN (
    echo GitHub token is not configured.
    echo.
    echo Enter your GitHub fine-grained token.
    echo It will be saved for future runs as the Windows user variable GH_TOKEN.
    echo.
    for /f "delims=" %%T in ('powershell -NoProfile -Command "$s=Read-Host Token -AsSecureString; $b=[Runtime.InteropServices.Marshal]::SecureStringToBSTR($s); try { $t=[Runtime.InteropServices.Marshal]::PtrToStringBSTR($b); [Environment]::SetEnvironmentVariable('GH_TOKEN',$t,'User'); $t } finally { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($b) }"') do set "GH_TOKEN=%%T"
    echo.
    if not defined GH_TOKEN (
echo ERROR: Token was not saved.
        echo.
        pause
        exit /b 1
    )
    echo GitHub token saved. Future runs will use it automatically.
    echo.
)

rem Self-update from the newest successful artifact on this branch.
rem The downloaded artifact contains the authoritative flash.bat.
set "FLASHER_BUILD=__FLASHER_BUILD__"
set "SELF_UPDATE_DIR=%TEMP%\\esp32-c3-flasher-update-%RANDOM%%RANDOM%"
set "SELF_UPDATE_EXTRACT=!SELF_UPDATE_DIR!\\extracted"
set "SELF_PATH=%~f0"
mkdir "!SELF_UPDATE_DIR!" >nul 2>&1
mkdir "!SELF_UPDATE_EXTRACT!" >nul 2>&1

call :UI_STATUS "Checking for a newer flasher..."
set "UPDATE_RUN="
set "UPDATE_RUN_NUMBER="
set "UPDATE_RUN_STATUS="
set "UPDATE_RUN_CONCLUSION="

for /f "delims=" %%I in ('gh run list --repo candoo32-glitch/esp32-c3-pc-relay --workflow build.yml --branch "!TARGET_BRANCH!" --limit 1 --json databaseId --jq ".[0].databaseId"') do set "UPDATE_RUN=%%I"

if not defined UPDATE_RUN (
echo ERROR: Could not determine the newest build for flasher update.
    rmdir /s /q "!SELF_UPDATE_DIR!" >nul 2>&1
    pause
    exit /b 1
)

:WAIT_FOR_FLASHER_UPDATE_RUN
set "UPDATE_RUN_NUMBER="
set "UPDATE_RUN_STATUS="
set "UPDATE_RUN_CONCLUSION="
for /f "delims=" %%I in ('gh run view "!UPDATE_RUN!" --repo candoo32-glitch/esp32-c3-pc-relay --json number --jq ".number"') do set "UPDATE_RUN_NUMBER=%%I"
for /f "delims=" %%I in ('gh run view "!UPDATE_RUN!" --repo candoo32-glitch/esp32-c3-pc-relay --json status --jq ".status"') do set "UPDATE_RUN_STATUS=%%I"
for /f "delims=" %%I in ('gh run view "!UPDATE_RUN!" --repo candoo32-glitch/esp32-c3-pc-relay --json conclusion --jq ".conclusion"') do set "UPDATE_RUN_CONCLUSION=%%I"

if /I "!UPDATE_RUN_STATUS!"=="queued" (
    set "UI_MESSAGE=Newest build !UPDATE_RUN_NUMBER! is queued. Waiting before flashing..."
    call :UI_WAIT
    goto WAIT_FOR_FLASHER_UPDATE_RUN
)
if /I "!UPDATE_RUN_STATUS!"=="in_progress" (
    set "UI_MESSAGE=Newest build !UPDATE_RUN_NUMBER! is in progress. Waiting before flashing..."
    call :UI_WAIT
    goto WAIT_FOR_FLASHER_UPDATE_RUN
)
if /I "!UPDATE_RUN_STATUS!"=="waiting" (
    set "UI_MESSAGE=Newest build !UPDATE_RUN_NUMBER! is waiting. Waiting before flashing..."
    call :UI_WAIT
    goto WAIT_FOR_FLASHER_UPDATE_RUN
)

if /I not "!UPDATE_RUN_STATUS!"=="completed" (
echo ERROR: Flasher update build !UPDATE_RUN_NUMBER! has unexpected status "!UPDATE_RUN_STATUS!".
    rmdir /s /q "!SELF_UPDATE_DIR!" >nul 2>&1
    pause
    exit /b 1
)

if /I not "!UPDATE_RUN_CONCLUSION!"=="success" (
echo ERROR: Newest build !UPDATE_RUN_NUMBER! completed with conclusion "!UPDATE_RUN_CONCLUSION!".
    echo The flasher will not replace itself with a failed build.
    rmdir /s /q "!SELF_UPDATE_DIR!" >nul 2>&1
    pause
    exit /b 1
)

if "!UPDATE_RUN_NUMBER!"=="!FLASHER_BUILD!" (
    echo Flasher is already current ^(build !FLASHER_BUILD!^).
    rmdir /s /q "!SELF_UPDATE_DIR!" >nul 2>&1
) else (
    set "UPDATE_ARTIFACT_NAME=esp32-c3-pc-relay-!TARGET_BRANCH!-build-!UPDATE_RUN_NUMBER!"
    call :UI_STATUS "New flasher available from build !UPDATE_RUN_NUMBER!."
    call :UI_LOG "Downloading updated flasher artifact."

    gh run download "!UPDATE_RUN!" --repo candoo32-glitch/esp32-c3-pc-relay --name "!UPDATE_ARTIFACT_NAME!" --dir "!SELF_UPDATE_EXTRACT!" >nul 2>&1
    if errorlevel 1 (
echo ERROR: Could not download the newer flasher artifact.
        rmdir /s /q "!SELF_UPDATE_DIR!" >nul 2>&1
        pause
        exit /b 1
    )

    if not exist "!SELF_UPDATE_EXTRACT!\\flash.bat" (
echo ERROR: New artifact does not contain flash.bat.
        rmdir /s /q "!SELF_UPDATE_DIR!" >nul 2>&1
        pause
        exit /b 1
    )

    set "UPDATE_SCRIPT=!SELF_UPDATE_EXTRACT!\\flash.bat"
    set "UPDATE_HELPER=!SELF_UPDATE_DIR!\\replace-flasher.cmd"
    >"!UPDATE_HELPER!" echo @echo off
    >>"!UPDATE_HELPER!" echo timeout /t 1 /nobreak ^>nul
    >>"!UPDATE_HELPER!" echo copy /y "!UPDATE_SCRIPT!" "!SELF_PATH!" ^>nul
    >>"!UPDATE_HELPER!" echo if errorlevel 1 ^(
    >>"!UPDATE_HELPER!" echo     echo ERROR: Could not replace the running flasher.
    >>"!UPDATE_HELPER!" echo     pause
    >>"!UPDATE_HELPER!" echo     exit /b 1
    >>"!UPDATE_HELPER!" echo ^)
    >>"!UPDATE_HELPER!" echo echo Flasher updated to build !UPDATE_RUN_NUMBER!.
    >>"!UPDATE_HELPER!" echo echo Starting updated flasher...
    >>"!UPDATE_HELPER!" echo call "!SELF_PATH!" __ESP32_INTERNAL
    >>"!UPDATE_HELPER!" echo echo.
    >>"!UPDATE_HELPER!" echo echo Updated flasher exited with errorlevel %%ERRORLEVEL%%.
    >>"!UPDATE_HELPER!" echo pause
    call :UI_STATUS "Updating flash.bat in place..."
    call :UI_LOG "Current flasher will close for the in-place update."
    call :UI_LOG "Update helper will report any replacement error."
    start "ESP32 Flasher Update" "%ComSpec%" /d /c call "!UPDATE_HELPER!"
    endlocal
    exit /b 0
)

set "LATEST_RUN="
set "LATEST_RUN_NUMBER="
set "LATEST_RUN_STATUS="
set "LATEST_RUN_CONCLUSION="
set "EXPECTED_ARTIFACT_NAME="

call :UI_FIELD 5 "Branch" "!TARGET_BRANCH!"
call :UI_STATUS "Searching GitHub for the newest build..."
echo.

rem Always inspect the newest branch run first. If it is queued or
rem running, wait for that exact run instead of falling back to an
rem older successful artifact.
for /f "delims=" %%I in ('gh run list --repo candoo32-glitch/esp32-c3-pc-relay --workflow build.yml --branch "!TARGET_BRANCH!" --limit 1 --json databaseId --jq ".[0].databaseId"') do set "LATEST_RUN=%%I"

if not defined LATEST_RUN (
echo ERROR: No build was found for branch !TARGET_BRANCH!.
    echo.
    pause
    exit /b 1
)

:WAIT_FOR_BUILD
set "LATEST_RUN_NUMBER="
set "LATEST_RUN_STATUS="
set "LATEST_RUN_CONCLUSION="

for /f "delims=" %%I in ('gh run view "!LATEST_RUN!" --repo candoo32-glitch/esp32-c3-pc-relay --json number --jq ".number"') do set "LATEST_RUN_NUMBER=%%I"
for /f "delims=" %%I in ('gh run view "!LATEST_RUN!" --repo candoo32-glitch/esp32-c3-pc-relay --json status --jq ".status"') do set "LATEST_RUN_STATUS=%%I"
for /f "delims=" %%I in ('gh run view "!LATEST_RUN!" --repo candoo32-glitch/esp32-c3-pc-relay --json conclusion --jq ".conclusion"') do set "LATEST_RUN_CONCLUSION=%%I"

if not defined LATEST_RUN_NUMBER (
echo ERROR: Could not read build !LATEST_RUN!.
    echo.
    pause
    exit /b 1
)

if /I "!LATEST_RUN_STATUS!"=="queued" (
    set "UI_MESSAGE=Build !LATEST_RUN_NUMBER! is queued. Waiting..."
    call :UI_WAIT
    goto WAIT_FOR_BUILD
)

if /I "!LATEST_RUN_STATUS!"=="in_progress" (
    set "UI_MESSAGE=Build !LATEST_RUN_NUMBER! is in progress. Waiting..."
    call :UI_WAIT
    goto WAIT_FOR_BUILD
)

if /I "!LATEST_RUN_STATUS!"=="waiting" (
    set "UI_MESSAGE=Build !LATEST_RUN_NUMBER! is waiting. Waiting..."
    call :UI_WAIT
    goto WAIT_FOR_BUILD
)

if /I not "!LATEST_RUN_STATUS!"=="completed" (
echo ERROR: Build !LATEST_RUN_NUMBER! ended in unexpected status "!LATEST_RUN_STATUS!".
    echo.
    pause
    exit /b 1
)

if /I not "!LATEST_RUN_CONCLUSION!"=="success" (
echo ERROR: Newest build !LATEST_RUN_NUMBER! completed with conclusion "!LATEST_RUN_CONCLUSION!".
    echo The flasher will not fall back to an older build.
    echo.
    pause
    exit /b 1
)

set "EXPECTED_ARTIFACT_NAME=esp32-c3-pc-relay-!TARGET_BRANCH!-build-!LATEST_RUN_NUMBER!"
call :UI_FIELD 13 "Run ID" "!LATEST_RUN!"
call :UI_FIELD 6 "Build" "!LATEST_RUN_NUMBER!"
call :UI_FIELD 11 "Artifact" "!EXPECTED_ARTIFACT_NAME!"
echo.
set "DOWNLOAD_DIR=%TEMP%\esp32-c3-relay-%RANDOM%%RANDOM%"
set "EXTRACT_DIR=!DOWNLOAD_DIR!\extracted"
set "LOCAL_DIR=%~dp0"
set "LOCAL_FIRMWARE=!LOCAL_DIR!firmware"
mkdir "!DOWNLOAD_DIR!" >nul 2>&1
mkdir "!EXTRACT_DIR!" >nul 2>&1

call :UI_STATUS "Downloading verified firmware artifact..."
gh run download "!LATEST_RUN!" --repo candoo32-glitch/esp32-c3-pc-relay --name "!EXPECTED_ARTIFACT_NAME!" --dir "!EXTRACT_DIR!" >nul 2>&1
if errorlevel 1 (
echo ERROR: GitHub artifact download failed.
    rmdir /s /q "!DOWNLOAD_DIR!" >nul 2>&1
    echo.
    pause
    exit /b 1
)

if not exist "!EXTRACT_DIR!\firmware\factory.bin" (
echo ERROR: Extracted artifact does not contain firmware\factory.bin.
    echo.
                  rmdir /s /q "!DOWNLOAD_DIR!" >nul 2>&1
    pause
    exit /b 1
)
if not exist "!EXTRACT_DIR!\BUILD_VERSION.txt" (
echo ERROR: BUILD_VERSION.txt is missing from the artifact.
    rmdir /s /q "!DOWNLOAD_DIR!" >nul 2>&1
    echo.
    pause
    exit /b 1
)
if not exist "!EXTRACT_DIR!\RUN_ID.txt" (
echo ERROR: RUN_ID.txt is missing from the artifact.
    rmdir /s /q "!DOWNLOAD_DIR!" >nul 2>&1
    echo.
    pause
    exit /b 1
)
if not exist "!EXTRACT_DIR!\ARTIFACT_NAME.txt" (
echo ERROR: ARTIFACT_NAME.txt is missing from the artifact.
    rmdir /s /q "!DOWNLOAD_DIR!" >nul 2>&1
    echo.
    pause
    exit /b 1
)

set /p "ARTIFACT_BUILD_VERSION="<"!EXTRACT_DIR!\BUILD_VERSION.txt"
set /p "ARTIFACT_RUN_ID="<"!EXTRACT_DIR!\RUN_ID.txt"
set /p "ACTUAL_ARTIFACT_NAME="<"!EXTRACT_DIR!\ARTIFACT_NAME.txt"
if not "!ACTUAL_ARTIFACT_NAME!"=="!EXPECTED_ARTIFACT_NAME!" (
echo ERROR: Artifact name mismatch.
    echo Expected: !EXPECTED_ARTIFACT_NAME!
    echo Artifact : !ACTUAL_ARTIFACT_NAME!
    rmdir /s /q "!DOWNLOAD_DIR!" >nul 2>&1
    echo.
    pause
    exit /b 1
)
if not "!ARTIFACT_RUN_ID!"=="!LATEST_RUN!" (
echo ERROR: Artifact run ID mismatch.
    echo Expected: !LATEST_RUN!
    echo Artifact : !ARTIFACT_RUN_ID!
    rmdir /s /q "!DOWNLOAD_DIR!" >nul 2>&1
    echo.
    pause
    exit /b 1
)
if not defined ARTIFACT_BUILD_VERSION (
echo ERROR: Artifact firmware build version is empty.
    rmdir /s /q "!DOWNLOAD_DIR!" >nul 2>&1
    echo.
    pause
    exit /b 1
)

echo.
echo ========================================
call :UI_STATUS "Firmware artifact verified."
echo ========================================
call :UI_FIELD 13 "Run ID" "!ARTIFACT_RUN_ID!"
call :UI_FIELD 12 "Firmware" "!ARTIFACT_BUILD_VERSION!"
call :UI_FIELD 11 "Artifact" "!ACTUAL_ARTIFACT_NAME!"
call :UI_FIELD 15 "Image" "factory.bin (4 MB)"
echo ========================================
echo.
call :UI_STATUS "Synchronizing local firmware..."
if exist "!LOCAL_FIRMWARE!" rmdir /s /q "!LOCAL_FIRMWARE!"
mkdir "!LOCAL_FIRMWARE!" >nul 2>&1
xcopy /e /i /y /q "!EXTRACT_DIR!\firmware" "!LOCAL_FIRMWARE!" >nul 2>&1
if errorlevel 1 (
echo ERROR: Could not update the local firmware directory.
    rmdir /s /q "!DOWNLOAD_DIR!" >nul 2>&1
    echo.
    pause
    exit /b 1
)
copy /y "!EXTRACT_DIR!\README.txt" "!LOCAL_DIR!README.txt" >nul
copy /y "!EXTRACT_DIR!\SHA256SUMS.txt" "!LOCAL_DIR!SHA256SUMS.txt" >nul
copy /y "!EXTRACT_DIR!\BUILD_VERSION.txt" "!LOCAL_DIR!BUILD_VERSION.txt" >nul
copy /y "!EXTRACT_DIR!\RUN_ID.txt" "!LOCAL_DIR!RUN_ID.txt" >nul
copy /y "!EXTRACT_DIR!\ARTIFACT_NAME.txt" "!LOCAL_DIR!ARTIFACT_NAME.txt" >nul
rmdir /s /q "!DOWNLOAD_DIR!" >nul 2>&1

if not exist "!LOCAL_FIRMWARE!\factory.bin" (
echo ERROR: Local factory.bin is missing after synchronization.
    echo.
    pause
    exit /b 1
)
call :UI_STATUS "Local firmware synchronized with build !ARTIFACT_BUILD_VERSION!."
echo.
call :UI_STATUS "Verified image ready to flash."
echo.
call :UI_FIELD 19 "Stage" "Programming flash"
call :UI_PROGRESS 75 "Writing factory.bin to ESP32-C3"
py -m esptool --chip esp32c3 --port-filter vid=0x303A --port-filter pid=0x1001 --after hard-reset write-flash 0x0 "!LOCAL_FIRMWARE!\factory.bin" >"!FLASH_LOG!" 2>&1
set "FLASH_EXIT=!ERRORLEVEL!"
echo.
if not "!FLASH_EXIT!"=="0" (
        call :UI_STATUS "FLASH FAILED"
    call :UI_FIELD 19 "Stage" "FAILED (exit !FLASH_EXIT!)"
    call :UI_FIELD 21 "Detail" "Diagnostic log saved to:"
    call :UI_FIELD 22 "Log" "!FLASH_LOG!"
    echo.
    echo !VT!90m  Press any key to return...!VT!0m
    pause
    exit /b !FLASH_EXIT!
)
call :UI_PROGRESS 100 "Programming complete"
call :UI_FIELD 19 "Stage" "Complete"
call :UI_STATUS "FLASH SUCCESSFUL"
call :UI_FIELD 21 "Detail" "Firmware build !ARTIFACT_BUILD_VERSION! flashed successfully."
echo.
call :UI_FIELD 31 "Action" "Press any key to close..."
pause
if exist "!FLASH_LOG!" del /q "!FLASH_LOG!" >nul 2>&1
exit /b 0

:UI_INIT
mode con: cols=100 lines=34 >nul 2>&1
<nul set /p "=!VT!2J!VT!H"
echo !VT!1;36m+==================================================================================================+!VT!0m
echo !VT!1;36m^|                         ESP32-C3 PC RELAY  -  FIRMWARE FLASHER                         ^|!VT!0m
echo !VT!1;36m+==================================================================================================+!VT!0m
echo !VT!1;37m^| REPOSITORY                                                                                       ^|!VT!0m
echo !VT!36m^| +------------------------------------------------------------------------------------------------+ ^|!VT!0m
echo !VT!36m^| ^| Branch      !VT!0mchecking...                                                                    !VT!36m^| ^|!VT!0m
echo !VT!36m^| ^| Build       !VT!0mchecking...                                                                    !VT!36m^| ^|!VT!0m
echo !VT!36m^| ^| Status      !VT!0mstarting...                                                                    !VT!36m^| ^|!VT!0m
echo !VT!36m^| +------------------------------------------------------------------------------------------------+ ^|!VT!0m
echo !VT!1;37m^| ARTIFACT                                                                                         ^|!VT!0m
echo !VT!36m^| +------------------------------------------------------------------------------------------------+ ^|!VT!0m
echo !VT!36m^| ^| Artifact    !VT!0mwaiting...                                                                     !VT!36m^| ^|!VT!0m
echo !VT!36m^| ^| Firmware    !VT!0mwaiting...                                                                     !VT!36m^| ^|!VT!0m
echo !VT!36m^| ^| Run ID      !VT!0mwaiting...                                                                     !VT!36m^| ^|!VT!0m
echo !VT!36m^| ^| Integrity   !VT!0mpending                                                                      !VT!36m^| ^|!VT!0m
echo !VT!36m^| ^| Image       !VT!0mpending                                                                      !VT!36m^| ^|!VT!0m
echo !VT!36m^| +------------------------------------------------------------------------------------------------+ ^|!VT!0m
echo !VT!1;37m^| FLASH STATUS                                                                                     ^|!VT!0m
echo !VT!36m^| +------------------------------------------------------------------------------------------------+ ^|!VT!0m
echo !VT!36m^| ^| Device      !VT!0mESP32-C3                                                                       !VT!36m^| ^|!VT!0m
echo !VT!36m^| ^| Stage       !VT!0mStarting                                                                        !VT!36m^| ^|!VT!0m
echo !VT!36m^| ^| Progress    !VT!0m[░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░]   0%                         !VT!36m^| ^|!VT!0m
echo !VT!36m^| ^| Detail      !VT!0midle                                                                            !VT!36m^| ^|!VT!0m
echo !VT!36m^| +------------------------------------------------------------------------------------------------+ ^|!VT!0m
echo !VT!1;37m^| ACTIVITY LOG                                                                                     ^|!VT!0m
echo !VT!36m^| +------------------------------------------------------------------------------------------------+ ^|!VT!0m
echo !VT!36m^| ^|                                                                                                  ^| ^|!VT!0m
echo !VT!36m^| ^|                                                                                                  ^| ^|!VT!0m
echo !VT!36m^| ^|                                                                                                  ^| ^|!VT!0m
echo !VT!36m^| ^|                                                                                                  ^| ^|!VT!0m
echo !VT!36m^| +------------------------------------------------------------------------------------------------+ ^|!VT!0m
echo !VT!1;36m+==================================================================================================+!VT!0m
echo !VT!1;37m^| READY                                                                                               ^|!VT!0m
echo !VT!1;36m+==================================================================================================+!VT!0m
exit /b 0

:UI_FIELD
<nul set /p "=!VT!%~1;1H!VT!2K!VT!36m^| ^| %~2      !VT!0m%~3!VT!36m                                                                      ^| ^|!VT!0m"
exit /b 0

:UI_STATUS
<nul set /p "=!VT!7;1H!VT!2K!VT!36m^| ^| Status      !VT!0m!VT!96m● %~1!VT!36m                                                                      ^| ^|!VT!0m"
call :UI_LOG "%~1"
exit /b 0

:UI_PROGRESS
set "UI_PCT=%~1"
set "UI_DETAIL=%~2"
set "UI_FILLED="
set /a "UI_N=UI_PCT/2"
for /l %%P in (1,1,50) do if %%P LEQ !UI_N! set "UI_FILLED=!UI_FILLED!#"
for /l %%P in (1,1,50) do if %%P GTR !UI_N! set "UI_FILLED=!UI_FILLED!."
<nul set /p "=!VT!20;1H!VT!2K!VT!36m^| ^| Progress    !VT!0m[!VT!92m!UI_FILLED!!VT!36m] !UI_PCT!%%                                                                    !VT!36m^| ^|!VT!0m"
<nul set /p "=!VT!21;1H!VT!2K!VT!36m^| ^| Detail      !VT!0m!UI_DETAIL!                                                                      !VT!36m^| ^|!VT!0m"
exit /b 0

:UI_LOG
set "UI_L4=!UI_L3!"
set "UI_L3=!UI_L2!"
set "UI_L2=!UI_L1!"
set "UI_L1=%~1"
<nul set /p "=!VT!25;1H!VT!2K!VT!36m^| ^| !VT!0m!UI_L4!                                                                      !VT!36m^| ^|!VT!0m"
<nul set /p "=!VT!26;1H!VT!2K!VT!36m^| ^| !VT!0m!UI_L3!                                                                      !VT!36m^| ^|!VT!0m"
<nul set /p "=!VT!27;1H!VT!2K!VT!36m^| ^| !VT!0m!UI_L2!                                                                      !VT!36m^| ^|!VT!0m"
<nul set /p "=!VT!28;1H!VT!2K!VT!36m^| ^| !VT!0m!UI_L1!                                                                      !VT!36m^| ^|!VT!0m"
exit /b 0

:UI_WAIT
for /l %%S in (1,1,10) do (
    set /a "UI_POS=%%S %% 4"
    if !UI_POS!==0 set "UI_BAR=>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>"
    if !UI_POS!==1 set "UI_BAR=>>>>>>>>>>>>>>>>>>>>>>>>>........................."
    if !UI_POS!==2 set "UI_BAR=>>>>>>>>>>........................................"
    if !UI_POS!==3 set "UI_BAR=>>................................................"
    <nul set /p "=!VT!19;1H!VT!2K!VT!36m^| ^| Stage       !VT!0mWaiting                                                                        !VT!36m^| ^|!VT!0m"
    <nul set /p "=!VT!20;1H!VT!2K!VT!36m^| ^| Progress    !VT!0m[!VT!93m!UI_BAR!!VT!36m]       !VT!36m^| ^|!VT!0m"
    <nul set /p "=!VT!21;1H!VT!2K!VT!36m^| ^| Detail      !VT!0m!UI_MESSAGE!                                                                      !VT!36m^| ^|!VT!0m"
    timeout /t 1 /nobreak >nul
)
exit /b 0

:FLASH_MAIN_END

:FLASH_MAIN_END

:FLASH_MAIN_END_DONE
endlocal
