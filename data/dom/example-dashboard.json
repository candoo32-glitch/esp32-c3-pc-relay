{
  "version": 2,
  "name": "V2 component demonstration",
  "responsive": true,
  "defaultView": "main",
  "tokens": {
    "accent": "#d49a42",
    "panel": "#17191d",
    "surface": "#20242a",
    "border": "#5c4a31",
    "radius": "8px",
    "panel-padding": "14px"
  },
  "views": {
    "main": {
      "title": "DOM V2 Component Demonstration",
      "navigation": true,
      "layout": {
        "type": "grid",
        "columns": "repeat(4,minmax(0,1fr))",
        "gap": "10px",
        "children": [
          {"type":"panel","label":"System","children":[
            {"type":"value","label":"Build","bind":"system.build"},
            {"type":"value","label":"CPU","bind":"system.cpu","format":"number"}
          ]},
          {"type":"panel","label":"Wi-Fi","children":[
            {"type":"status","label":"Status","bind":"wifi.status"},
            {"type":"value","label":"RSSI","bind":"wifi.rssi","format":"dbm"}
          ]},
          {"type":"gauge","label":"CPU","bind":"system.cpu","min":0,"max":100,"format":"number"},
          {"type":"relay","relay":0},
          {"type":"relay","relay":1},
          {"type":"panel","label":"Network","children":[
            {"type":"value","label":"IP","bind":"network.ip"},
            {"type":"value","label":"Gateway","bind":"network.gateway"},
            {"type":"value","label":"DNS 1","bind":"network.dns1"}
          ]},
          {"type":"panel","label":"Actions","children":[
            {"type":"button","text":"Reconnect Wi-Fi","action":{"action":"wifi.reconnect"}},
            {"type":"button","text":"Reboot","action":{"action":"system.reboot"}}
          ]}
        ]
      }
    }
  }
}
